  "combinations": [
    {
      "class_id": "substance:13723",
      "drug": "BIKALUTAMID",
      "effect": "Bikalutamid inhibuje CYP3A4 a může zvýšit expozici lékům metabolizovaným hlavně tímto enzymem. Po 28 dnech současného užívání se expozice midazolamu zvýšila až o 80 %; u léků s úzkým terapeutickým rozmezím může být tento nárůst významný. U cyklosporinu a blokátorů kalciových kanálů může být nutné snížení dávky; při cyklosporinu se po zahájení nebo ukončení léčby sleduje jeho hladina a klinický stav. Cimetidin a ketokonazol mohou zvýšit koncentraci bikalutamidu a teoreticky zesílit jeho nežádoucí účinky. Terfenadin, astemizol a cisaprid se s bikalutamidem nesmějí užívat současně.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:B01AA",
      "drug_class": "Kumarinová antikoagulancia, například warfarin",
      "effect": "Bikalutamid může zvýšit účinek kumarinových antikoagulancií a prodloužit protrombinový čas či zvýšit INR; byly hlášeny případy s rizikem krvácení. Lékař může pečlivě sledovat PT/INR a zvážit úpravu dávky antikoagulancia.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:qt_prolonging",
      "drug_class": "Léky prodlužující QT interval nebo vyvolávající torsade de pointes",
      "effect": "Při současném užívání bikalutamidu s léky prodlužujícími QT interval nebo s léky, které mohou vyvolat torsade de pointes, je třeba pečlivě zvážit přínosy a rizika. Mezi příklady patří antiarytmika třídy IA nebo III, methadon, moxifloxacin a antipsychotika. Text PIL zmiňuje možné vzájemné ovlivnění s přípravky k léčbě poruch srdečního rytmu; SPC uvádí, že souvislost s prodloužením QT vyplývá z androgen-deprivační léčby.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:13723",
      "drug": "BIKALUTAMID",
      "effect": "Bikalutamid vytěsňuje warfarin z vazebných míst na bílkovinách, což může zvýšit účinek warfarinu a dalších kumarinových antikoagulancií.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    }
  ],

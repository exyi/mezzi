  "combinations": [
    {
      "class_id": "group:cyp3a4_inhibitor_strong",
      "drug_class": "Silné inhibitory CYP3A4",
      "effect": "Mohou významně zvýšit hladinu atorvastatinu v krvi a riziko svalových nežádoucích účinků včetně myopatie a rabdomyolýzy. Pokud se souběžnému užívání nelze vyhnout, lékař zvolí nižší počáteční i maximální dávku atorvastatinu a bude vás pečlivě sledovat. Příklady zahrnují některá antimykotika, některá antibiotika a inhibitory HIV proteázy.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inhibitor_moderate",
      "drug_class": "Středně silné inhibitory CYP3A4",
      "effect": "Mohou zvýšit hladinu atorvastatinu v krvi a riziko myopatie, zvláště při erythromycinu. Lékař může zvolit nižší maximální dávku atorvastatinu a po zahájení léčby nebo změně dávky inhibitoru vás bude klinicky sledovat. Příklady zahrnují erythromycin, diltiazem, verapamil a flukonazol.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inducer",
      "drug_class": "Induktory CYP3A4",
      "effect": "Mohou snížit hladinu atorvastatinu v krvi a jeho účinek, přičemž míra snížení je proměnlivá. Rifampicin může hladinu při souběžném podání zvýšit, zatímco při časově odděleném podání může být výrazně nižší. Pokud se kombinaci nelze vyhnout, lékař bude sledovat účinnost léčby; atorvastatin a rifampicin se doporučuje podat současně. Příklady zahrnují efavirenz, rifampicin a třezalku tečkovanou.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:pgp_inhibitor",
      "drug_class": "Inhibitory transportních proteinů",
      "effect": "Mohou zvýšit systémovou expozici atorvastatinu a riziko nežádoucích účinků. Pokud se souběžné podávání nedá vyhnout, lékař může snížit dávku atorvastatinu a sledovat jeho účinnost. Příklady zahrnují cyklosporin a letermovir.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:C10AB",
      "drug_class": "Fibráty",
      "effect": "Současné užívání s atorvastatinem může zvýšit riziko svalových nežádoucích účinků včetně rabdomyolýzy. Pokud se kombinaci nelze vyhnout, lékař zvolí nejnižší účinnou dávku atorvastatinu a bude vás sledovat.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:1516",
      "drug": "Ezetimib",
      "effect": "Současné užívání s atorvastatinem může zvýšit riziko svalových nežádoucích účinků včetně rabdomyolýzy. Doporučuje se klinické sledování.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:1808",
      "drug": "Kolestipol",
      "effect": "Snižuje koncentraci atorvastatinu a jeho aktivních metabolitů v krvi; poměr koncentrací atorvastatinu při kombinaci vůči samotnému atorvastatinu byl 0,74. Přesto byl účinek na snížení krevních tuků při kombinaci vyšší než při podání každého přípravku samostatně.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:1058",
      "drug": "Kyselina fusidová",
      "effect": "Při systémovém podání společně s atorvastatinem se zvyšuje riziko myopatie a rabdomyolýzy, včetně smrtelných případů; mechanismus není znám. Atorvastatin se nesmí užívat současně se systémovou léčbou kyselinou fusidovou ani během 7 dnů po jejím ukončení. Pokud je systémová léčba nezbytná, lékař dočasně přeruší atorvastatin; lze jej znovu zahájit 7 dní po poslední dávce kyseliny fusidové. Výjimečně lze dlouhodobou souběžnou léčbu závažné infekce zvážit pod pečlivým lékařským dohledem. Při ústním užívání kyseliny fusidové má být léčba atorvastatinem také dočasně přerušena.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:2571",
      "drug": "Kolchicin",
      "effect": "Při současném podávání atorvastatinu a kolchicinu byly hlášeny případy myopatie. Při předepisování této kombinace je nutná opatrnost.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:2959",
      "drug": "Daptomycin",
      "effect": "Při souběžném podávání s atorvastatinem byly hlášeny myopatie nebo rabdomyolýza. Lékař zváží dočasné vysazení atorvastatinu, pokud přínos kombinace nepřeváží riziko; pokud se kombinaci nelze vyhnout, doporučuje se klinické sledování a kontrola CK 2–3krát týdně.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {

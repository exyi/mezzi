  "combinations": [
    {
      "class_id": "group:cyp3a4_inhibitor_strong",
      "drug_class": "Silné inhibitory CYP3A4",
      "effect": "Prednison se metabolizuje přes CYP3A4; inhibitory snižují jeho clearance a mohou zvýšit jeho hladinu. Současné užívání včetně léčiv s kobicistatem zvyšuje riziko systémových nežádoucích účinků kortikosteroidů. Této kombinaci se má vyhnout, pokud přínos nepřeváží riziko; při použití bude lékař sledovat například měsíčkovitý obličej, přibývání na váze a vysokou hladinu cukru.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {

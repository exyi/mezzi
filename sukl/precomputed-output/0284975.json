  "combinations": [
    {
      "class_id": "group:cyp3a4_inhibitor",
      "drug_class": "Léky tlumící CYP3A4, například některá makrolidová antibiotika, azolová antimykotika a některé inhibitory proteáz",
      "effect": "Mohou zvýšit biologickou dostupnost fentanylu tím, že sníží jeho odbourávání, a zesílit nebo prodloužit opioidní účinky. Při současném užívání je třeba postupovat opatrně; lékař může upravit dávku Lunaldinu.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inducer",
      "drug_class": "Léky a přípravky indukující CYP3A4, například rifampicin, rifabutin, karbamazepin, fenytoin, fenobarbital a třezalka tečkovaná",
      "effect": "Mohou snížit účinnost fentanylu. Účinek indukce se může projevit postupně, může trvat nejméně 2 týdny, než zesílí, a po vysazení může nejméně 2 týdny odeznívat. Po ukončení nebo snížení dávky induktoru může vzrůst riziko účinku či toxicity fentanylu; lékař má léčbu pečlivě sledovat a podle potřeby upravit dávku Lunaldinu.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:cns_depressant",
      "drug_class": "Látky tlumící centrální nervový systém, například opioidy, celková anestetika, gabapentin nebo pregabalin, myorelaxancia, sedativní antidepresiva a antihistaminika, barbituráty, benzodiazepiny, hypnotika, antipsychotika, klonidin a příbuzné látky",
      "effect": "Mohou spolu s Lunaldinem zesílit útlum centrální nervové soustavy a zvýšit riziko ospalosti, útlumu dýchání, nízkého tlaku, kómatu a úmrtí. Současné podávání sedativ je určeno jen pro případy, kdy není možná jiná léčba; lékař má omezit dávku a dobu souběžné léčby a pacienty pečlivě sledovat.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },

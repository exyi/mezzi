  "combinations": [
    {
      "class_id": "group:cns_depressant",
      "drug_class": "Látky tlumící centrální nervový systém nebo dýchání",
      "effect": "Současné užívání s tapentadolem může zesílit ospalost, útlum dýchání a další tlumivé účinky; může vést ke kómatu nebo úmrtí. Kombinace je určena jen tehdy, když není jiná možnost léčby. Lékař má použít nejnižší účinné dávky po co nejkratší dobu a pacienta pečlivě sledovat; při kombinaci může být nutné snížit dávku. Patří sem sedativa, například benzodiazepiny a barbituráty, jiné opioidy včetně morfinu a kodeinu, antitusika, antipsychotika, H1-antihistaminika a alkohol.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Gabapentin nebo pregabalin",
      "effect": "Současné užívání tapentadolu s gabapentinem nebo pregabalinem zvyšuje riziko předávkování opioidy a útlumu dýchání, který může být život ohrožující.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Serotonergní léčiva, například SSRI, SNRI a tricyklická antidepresiva",
      "effect": "Při kombinaci s tapentadolem byl hlášen serotoninový syndrom, který může být život ohrožující. Riziko je třeba zvažovat při současném užívání; syndrom se může projevit mimovolními rytmickými stahy svalů, neklidem, pocením, třesem, zvýšenými reflexy, zvýšeným svalovým napětím a teplotou nad 38 °C.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Léčiva snižující práh pro vznik záchvatů",
      "effect": "Tapentadol může zvýšit jejich potenciál vyvolat křeče; patří sem SSRI, SNRI, tricyklická antidepresiva, antipsychotika a další léčiva snižující práh pro vznik záchvatů.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Inhibitory monoaminooxidázy (MAO)",
      "effect": "Tapentadol se nemá užívat současně s inhibitory MAO ani během 14 dnů po jejich vysazení; možný aditivní účinek na norepinefrin může vést ke kardiovaskulárním nežádoucím účinkům, například hypertenzní krizi.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Smíšení opioidní agonisté/antagonisté nebo parciální agonisté opioidních µ-receptorů",
      "effect": "Při současném užívání s tapentadolem nemusí tapentadol účinkovat dostatečně; kombinace vyžaduje opatrnost. Příklady jsou pentazocin, nalbufin a buprenorfin. U pacientů dlouhodobě užívajících buprenorfin k léčbě závislosti na opioidech se při nutnosti tapentadolu pro akutní bolest doporučuje převést na jinou léčbu; při souběžném podání může být nutná vyšší dávka plného opioidního agonisty a pečlivé sledování nežádoucích účinků, například útlumu dýchání.",
      "effect_type": "antagonism",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Silné inhibitory UGT1A6, UGT1A9 nebo UGT2B7",
      "effect": "Mohou zvýšit systémovou expozici tapentadolu. Jako příklady jsou uvedeny ketokonazol, flukonazol a kyselina meklofenamová.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Silné induktory enzymů",
      "effect": "Při zahájení nebo vysazení souběžné léčby může dojít ke snížení účinnosti tapentadolu nebo ke zvýšení rizika jeho nežádoucích účinků. Příklady jsou rifampicin, fenobarbital a třezalka tečkovaná.",
      "effect_type": "changed_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Léčiva s anticholinergními účinky",
      "effect": "Současné užívání s tapentadolem může zvýšit anticholinergní nežádoucí účinky. Patří sem některá antidepresiva, antihistaminika, antiemetika, antipsychotika, myorelaxancia a antiparkinsonika.",
      "effect_type": "increased_toxicity",

  "combinations": [
    {
      "class_id": "substance:8940",
      "drug": "Omeprazol",
      "effect": "Omeprazol středně silně inhibuje CYP2C19, a může proto zvýšit expozici léčiv metabolizovaných tímto enzymem, například R-warfarinu a dalších antagonistů vitaminu K, cilostazolu, diazepamu a fenytoinu. Při zahájení či ukončení léčby omeprazolem může lékař sledovat účinek nebo hladiny těchto léčiv a případně upravit jejich dávku; u fenytoinu se doporučuje sledování koncentrace během prvních dvou týdnů a po ukončení omeprazolu. U warfarinu a jiných antagonistů vitaminu K může být nutné sledování při zahájení nebo ukončení léčby.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:8940",
      "drug": "Omeprazol",
      "effect": "Omeprazol snižuje žaludeční kyselost, což může změnit vstřebávání léčiv závislých na pH žaludku. Vstřebávání posakonazolu a erlotinibu se významně snižuje a může se zhoršit jejich účinek; současné podávání těchto léčiv s omeprazolem má být vyloučeno. Vstřebávání ketokonazolu a itrakonazolu je také významně sníženo.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:8940",
      "drug": "Omeprazol",
      "effect": "Současné podávání omeprazolu a nelfinaviru je kontraindikováno: omeprazol snižuje expozici nelfinaviru přibližně o 40 % a jeho aktivního metabolitu o 75–90 %.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "substance:8940",
      "drug": "Omeprazol",
      "effect": "Omeprazol snižuje expozici atazanaviru. Současné podávání se nedoporučuje; pokud je nezbytné, doporučuje se pečlivé klinické sledování a zvýšení dávky atazanaviru na 400 mg s ritonavirem 100 mg, přičemž dávka omeprazolu nesmí překročit 20 mg. I při tomto režimu byla expozice atazanaviru snížena přibližně o 30 %.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:8940",
      "drug": "Omeprazol",
      "effect": "Omeprazol může zvýšit biologickou dostupnost digoxinu. Opatrnost je potřebná zejména u starších pacientů užívajících vysoké dávky omeprazolu; lékař má zintenzivnit sledování hladin digoxinu.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:8940",
      "drug": "Omeprazol",
      "effect": "Omeprazol snižuje expozici aktivnímu metabolitu klopidogrelu a jeho protidestičkový účinek; podávání současně se nedoporučuje. Rozdělení užívání do různých časů interakci neodstraňuje. Klinický význam pro kardiovaskulární příhody je podle dostupných údajů nejistý.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:8940",
      "drug": "Omeprazol",
      "effect": "Současné podávání omeprazolu může zvýšit sérové koncentrace takrolimu. Lékař má zesíleně sledovat jeho koncentraci a funkci ledvin a podle potřeby upravit dávku takrolimu.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:8940",
      "drug": "Omeprazol",
      "effect": "U některých pacientů byly při souběžném podávání inhibitorů protonové pumpy a methotrexátu hlášeny zvýšené hladiny methotrexátu. Při vysokých dávkách methotrexátu má lékař zvážit dočasné přerušení léčby omeprazolem.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:8940",
      "drug": "Omeprazol",
      "effect": "Léčiva inhibující CYP2C19 nebo CYP3A4, například klarithromycin a vorikonazol, mohou zpomalit metabolismus omeprazolu a zvýšit jeho sérovou koncentraci. Při vorikonazolu se expozice omeprazolu přibližně zdvojnásobila; úprava dávky omeprazolu obvykle není nutná, ale lékař ji má zvážit při závažné poruše funkce jater nebo dlouhodobé léčbě.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:8940",
      "drug": "Omeprazol",
      "effect": "Léčiva indukující CYP2C19 nebo CYP3A4, například rifampicin a třezalka tečkovaná, mohou zrychlit metabolismus omeprazolu a snížit jeho sérovou koncentraci.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    }
  ],

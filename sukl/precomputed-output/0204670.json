  "combinations": [
    {
      "class_id": "group:cyp3a4_inhibitor_strong",
      "drug_class": "Silné inhibitory CYP3A4",
      "effect": "Mohou výrazně zvýšit koncentraci atorvastatinu a riziko svalových nežádoucích účinků včetně myopatie a rhabdomyolýzy. Současnému podávání je třeba se vyvarovat; pokud je nezbytné, lékař zváží nižší zahajovací a maximální dávku atorvastatinu a pečlivé sledování.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inhibitor_moderate",
      "drug_class": "Středně silné inhibitory CYP3A4",
      "effect": "Mohou zvýšit koncentraci atorvastatinu a riziko myopatie. Lékař může zvolit nižší maximální dávku a sledovat pacienta, zejména po zahájení léčby nebo změně dávky inhibitoru.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inducer",
      "drug_class": "Induktory CYP3A4",
      "effect": "Efavirenz, rifampicin nebo třezalka tečkovaná mohou snížit koncentraci atorvastatinu; míra účinku se může lišit. Při současném užívání rifampicinu lékař doporučuje podat oba přípravky současně a sledovat účinnost léčby, protože pozdější podání atorvastatinu může jeho koncentraci výrazně snížit.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:14884",
      "drug": "Cyklosporin",
      "effect": "Cyklosporin může zvýšit systémovou expozici atorvastatinu a riziko myopatie či rhabdomyolýzy. Pokud se souběžnému podávání nelze vyhnout, lékař zváží snížení dávky atorvastatinu a klinické sledování; kombinace letermoviru a cyklosporinu s atorvastatinem se nedoporučuje.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:14884",
      "drug": "Kyselina fusidová",
      "effect": "Při systémové léčbě kyselinou fusidovou se atorvastatin nesmí užívat současně ani 7 dní po jejím ukončení; léčba atorvastatinem se po dobu léčby kyselinou fusidovou přeruší. Výjimečně lze dlouhodobé souběžné podávání při závažné infekci zvážit pod pečlivým lékařským dohledem. Riziko svalových potíží včetně rhabdomyolýzy se zvyšuje. Po poslední dávce kyseliny fusidové lze atorvastatin znovu zahájit za 7 dní.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "substance:14884",
      "drug": "Daptomycin",
      "effect": "Současné podávání může zvýšit riziko myopatie nebo rhabdomyolýzy. Lékař může zvážit dočasné přerušení atorvastatinu; pokud se kombinaci nelze vyhnout, sleduje pacienta a může kontrolovat CK 2–3krát týdně.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:C10AB",
      "drug_class": "Fibráty",
      "effect": "Současné užívání s atorvastatinem může zvýšit riziko svalových nežádoucích účinků včetně rhabdomyolýzy. Pokud se kombinaci nelze vyhnout, lékař zvolí nejnižší účinnou dávku atorvastatinu a pacienta sleduje.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },

  "combinations": [
    {
      "class_id": "atc:N03A",
      "drug_class": "Antiepileptika",
      "effect": "Kyselina listová může urychlit metabolismus antiepileptik, například fenytoinu, karbamazepinu a barbiturátů, a snížit jejich krevní hladinu; antiepileptika mohou současně snížit hladinu kyseliny listové. Lékař může sledovat hladiny antiepileptik a upravit jejich dávku. Po nasazení kyseliny listové může u pacientů užívajících fenytoin vzrůst četnost epileptických záchvatů.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Antacida obsahující hliník a hořčík",
      "effect": "Snižují vstřebávání kyseliny listové z tenkého střeva. Užívají se nejdříve 2 hodiny po kyselině listové.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Inhibitory dihydrofolátreduktázy",
      "effect": "Kyselina listová nekoriguje nedostatek folátů vyvolaný methotrexátem, trimethoprimem, pyrimetaminem nebo triamterenem; pro tento stav je podle SPC určen leukovorin.",
      "effect_type": "antagonism",
      "side_effects": []
    }
  ],
  "usage": "Přípravek se používá k prevenci a léčbě nedostatku kyseliny listové.",

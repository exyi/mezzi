  "combinations": [
    {
      "class_id": "group:cyp3a4_inhibitor_strong",
      "drug_class": "Silné inhibitory CYP3A4, například erythromycin, ketokonazol, itrakonazol, ritonavir, indinavir a nefazodon",
      "effect": "Tyto přípravky mohou podstatně zvýšit hladinu trazodonu v krvi. Při současném podávání silného inhibitoru CYP3A4 má lékař zvážit nižší dávku trazodonu; společnému podávání se má pokud možno vyhnout. Ritonavir 200 mg dvakrát denně zvýšil u zdravých dobrovolníků hladiny trazodonu více než dvojnásobně a vyvolal nevolnost, mdlobu a nízký krevní tlak.",
      "effect_type": "increased_exposure",
      "side_effects": [
        {
          "ctcae": "Nausea",
          "frequency": null,
          "label": "Při současném podávání ritonaviru byly hlášeny nevolnost, mdloba a nízký krevní tlak.",
          "action": null,
          "action_condition": null
        },
        {
          "ctcae": "Syncope",
          "frequency": null,
          "label": "Při současném podávání ritonaviru byly hlášeny nevolnost, mdloba a nízký krevní tlak.",
          "action": null,
          "action_condition": null
        },
        {
          "ctcae": "Hypotension",
          "frequency": null,
          "label": "Při současném podávání ritonaviru byly hlášeny nevolnost, mdloba a nízký krevní tlak.",
          "action": null,
          "action_condition": null
        }
      ]
    },
    {
      "class_id": "substance:11589",
      "drug": "Karbamazepin",
      "effect": "Karbamazepin snižuje hladiny trazodonu a jeho aktivního metabolitu m-chlorofenylpiperazinu v krvi. Při dávce karbamazepinu 400 mg denně klesly o 76 % a 60 %. Lékař má pacienta pečlivě sledovat a podle potřeby zvýšit dávku trazodonu.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:cyp2d6_inhibitor",
      "drug": "Fluoxetin",
      "effect": "Při současném podávání fluoxetinu byly vzácně hlášeny zvýšené hladiny trazodonu v krvi a nežádoucí účinky. Mechanismus není zcela znám; nelze vyloučit farmakodynamickou interakci se serotoninovým syndromem.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:N06AA",
      "drug_class": "Tricyklická antidepresiva",
      "effect": "Kvůli riziku interakcí se tricyklická antidepresiva nemají podávat současně s trazodonem. Je třeba věnovat pozornost serotoninovému syndromu a srdečně-cévním nežádoucím účinkům.",
      "effect_type": "contraindicated",
      "side_effects": [
        {
          "ctcae": "Serotonin syndrome",
          "frequency": null,
          "label": "Při souběžném užívání byly popsány případy serotoninového syndromu.",
          "action": null,
          "action_condition": null
        },
        {

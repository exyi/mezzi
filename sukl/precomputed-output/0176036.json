  "combinations": [
    {
      "class_id": "atc:B01AA",
      "drug_class": "Kumarinová antikoagulancia",
      "effect": "Bikalutamid může vytěsňovat kumarinová antikoagulancia z vazebného místa a zesílit jejich účinek. Může se prodloužit protrombinový čas (PT) a zvýšit INR, někdy s rizikem krvácení. Lékař má pečlivě sledovat PT/INR a zvážit úpravu dávky antikoagulancia.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:qt_prolonging",
      "drug_class": "Léčivé přípravky prodlužující QT interval",
      "effect": "Androgen-deprivační léčba včetně bikalutamidu může prodlužovat QT interval. Lékař má pečlivě zvážit souběžné užívání léků prodlužujících QT interval a přípravků, které mohou vyvolat torsade de pointes, například antiarytmik třídy IA nebo III, metadonu, moxifloxacinu či antipsychotik, zejména při dalších rizikových faktorech.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    }
  ],
  "usage": "Používá se k léčbě pokročilého karcinomu prostaty spolu s analogem LHRH nebo po chirurgické kastraci.",

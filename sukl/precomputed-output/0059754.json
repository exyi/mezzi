  "combinations": [
    {
      "class_id": "group:cns_depressant",
      "drug_class": "Látky tlumící centrální nervový systém, včetně antipsychotik, hypnotik, anxiolytik a sedativ, některých antidepresiv, antiepileptik, anestetik a sedativních antihistaminik",
      "effect": "Alprazolam má při současném užívání aditivní tlumivý účinek na centrální nervový systém a může zesílit útlum. Současné užívání alkoholu se nedoporučuje; alprazolam se má při kombinaci s jinými látkami tlumícími CNS používat opatrně.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cns_depressant",
      "drug_class": "Opioidy",
      "effect": "Současné užívání alprazolamu s opioidy, včetně opioidů pro substituční léčbu závislosti a některých léků proti kašli, zvyšuje riziko sedace, útlumu dýchání, kómatu a úmrtí. Kombinace je určena pouze tehdy, když není možná jiná léčba; lékař má omezit dávku a dobu současné léčby a předepsat nejnižší účinnou dávku po co nejkratší dobu. Pacient má kontaktovat lékaře, pokud zaznamená uvedené příznaky.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },

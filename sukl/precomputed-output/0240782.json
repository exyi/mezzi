  "combinations": [
    {
      "class_id": null,
      "drug_class": "Inhibitory monoaminooxidázy (IMAO)",
      "effect": "Buprenorfin Stada se nesmí užívat současně s IMAO ani během 2 týdnů po jejich užívání.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Léky tlumící centrální nervový systém, včetně jiných opioidů, některých antidepresiv, sedativních antihistaminik, léků na úzkost, antipsychotik, klonidinu a anestetik",
      "effect": "Mohou zesílit útlum centrálního nervového systému způsobený buprenorfinem. Při kombinaci se mohou zhoršit ospalost, mdloby a zpomalené či mělké dýchání; se sedativy, včetně benzodiazepinů a gabapentinoidů, hrozí také útlum dechu, nízký tlak, kóma nebo úmrtí. Současné užívání sedativ je určeno jen tehdy, není-li jiná možnost; lékař má omezit dávku a délku léčby a pacienta sledovat.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:serotonergic",
      "drug_class": "Serotonergní léky, například SSRI, SNRI a tricyklická antidepresiva",
      "effect": "Současné užívání s buprenorfinem může zvýšit riziko potenciálně život ohrožujícího serotoninového syndromu. Pokud je kombinace klinicky odůvodněná, lékař pacienta pečlivě sleduje, zejména při zahájení léčby a zvýšení dávky; při podezření může snížit dávku nebo léčbu přerušit.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inhibitor",
      "drug_class": "Inhibitory CYP3A4",
      "effect": "Mohou zvýšit plazmatickou koncentraci buprenorfinu a zesílit jeho účinek; lékař má dávku pečlivě titrovat a může být dostačující nižší dávka. Studie s ketokonazolem klinicky významné zvýšení expozice neprokázala.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Induktory enzymu CYP3A4",
      "effect": "Fenobarbital, karbamazepin, fenytoin a rifampicin mohou zvýšit odbourávání buprenorfinu, snížit jeho koncentraci a oslabit jeho účinek. Rozsah interakce nebyl studován.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Anticholinergika nebo léky s anticholinergním účinkem",
      "effect": "Současné užívání s buprenorfinem může zesílit nežádoucí anticholinergní účinky. Patří sem například některá tricyklická antidepresiva, antihistaminika, antipsychotika, léky uvolňující svaly a léky na Parkinsonovu nemoc.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    }
  ],
  "usage": "Používá se u dospělých k úlevě od středně silné dlouhodobé nenádorové bolesti, pokud jsou k její léčbě potřeba opioidy.",

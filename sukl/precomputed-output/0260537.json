    {
      "ctcae": "Rhabdomyolysis",
      "frequency": "rare",
      "label": "Vzácně: závažný rozpad svalových buněk; může se projevit svalovou slabostí, citlivostí či bolestí, přetržením svalů nebo červenohnědou močí. Riziko je vyšší při současném užívání některých léků. Může poškodit ledviny a ohrozit život.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Zvláště pokud se zároveň necítíte dobře nebo máte vysokou horečku.",
        "min_severity": 3
      }
    },
    {

  "combinations": [
    {
      "class_id": "group:cns_depressant",
      "drug_class": "Léky tlumící centrální nervový systém, včetně opioidů, lorazepamu a alkoholu",
      "effect": "Pregabalin může zesílit uklidňující účinky alkoholu a lorazepamu. Při současném užívání s opioidy nebo jinými léky tlumícími centrální nervový systém byly po uvedení na trh hlášeny selhání dýchání, kóma a úmrtí. Může se zvýšit závrať, ospalost a zhoršit soustředění; s oxykodonem může pregabalin zesílit zhoršení kognitivních a hrubých motorických funkcí. Riziko úmrtí souvisejícího s opioidy bylo ve studii vyšší při současném užívání pregabalinu; vyšší riziko bylo pozorováno i při dávce pregabalinu do 300 mg denně a trend byl výraznější při dávkách nad 300 mg denně. U pacientů s poraněním míchy se mohou účinky na centrální nervový systém zesílit při souběžné léčbě, například léky proti spasticitě. Alkohol se během léčby nedoporučuje.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    }
  ],

  "side_effects": [
    {
      "ctcae": "Diarrhea",
      "frequency": "common",
      "label": "Průjem; při dávce 400 mg denně se může objevit také závažný přetrvávající průjem, někdy s krví.",
      "action": "contact_doctor",
      "action_condition": {
        "patient_guide": "Pokud je průjem závažný a přetrvávající, zejména s bolestí nebo křečemi břicha, během léčby nebo krátce po ní; lék přestaňte užívat.",
        "min_severity": 2
      }
    },
    {
      "ctcae": "Colitis",
      "frequency": "very_rare",
      "label": "Zánět tlustého střeva související s antibiotiky, včetně pseudomembranózní kolitidy; může se projevit závažným přetrvávajícím průjmem, někdy s krví.",
      "action": "contact_doctor",
      "action_condition": {
        "patient_guide": "Pokud je průjem závažný a přetrvávající, zejména s bolestí nebo křečemi břicha, během léčby nebo krátce po ní; lék přestaňte užívat.",
        "min_severity": 2
      }
    },
    {
      "ctcae": "Anaphylaxis",
      "frequency": "very_rare",
      "label": "Náhlá závažná alergická reakce až anafylaktický šok s vyrážkou či kopřivkou, svěděním, otokem, tlakem na hrudi, dušností nebo kolapsem.",
      "action": "contact_doctor",
      "action_condition": {
        "patient_guide": "Při závažné alergické reakci nebo anafylaxi; lék přestaňte užívat.",
        "min_severity": 2

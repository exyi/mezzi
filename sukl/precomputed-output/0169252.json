  "combinations": [
    {
      "class_id": "atc:B01AA",
      "drug_class": "Perorální antikoagulancia",
      "effect": "Současné užívání klopidogrelu s perorálními antikoagulancii se nedoporučuje, protože může zvýšit intenzitu krvácení. U warfarinu klopidogrel 75 mg denně nemění farmakokinetiku S-warfarinu ani INR, ale oba léky zvyšují riziko krvácení nezávislými účinky na srážení krve.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:myelosuppressive",
      "drug_class": "Inhibitory glykoproteinových receptorů IIb/IIIa",
      "effect": "Při současném užívání s klopidogrelem je třeba opatrnost kvůli zvýšenému riziku krvácení.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:B01AC06",
      "drug_class": "Kyselina acetylsalicylová",
      "effect": "Klopidogrel může zesílit účinek kyseliny acetylsalicylové na shlukování krevních destiček a kombinace může zvýšit riziko krvácení. Při společném užívání je třeba opatrnost. V příbalové informaci se uvádí, že příležitostná dávka nejvýše 1 000 mg za 24 hodin většinou nezpůsobí potíže; delší užívání za jiných podmínek je třeba konzultovat s lékařem.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:B01AB01",
      "drug_class": "Heparin",
      "effect": "Současné podání heparinu s klopidogrelem může zvýšit riziko krvácení; při kombinaci je třeba opatrnost. Ve studii u zdravých dobrovolníků nebylo nutné upravit dávku heparinu a jeho účinek na srážení krve se nezměnil.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:M01A",
      "drug_class": "Nesteroidní protizánětlivé léky (NSAID), včetně inhibitorů COX-2",
      "effect": "Kombinace klopidogrelu s NSAID včetně inhibitorů COX-2 vyžaduje opatrnost kvůli riziku krvácení. U naproxenu bylo pozorováno zvýšení skrytých ztrát krve do trávicího traktu; není známo, zda se riziko zvýší u všech NSAID.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:serotonergic",
      "drug_class": "Selektivní inhibitory zpětného vychytávání serotoninu (SSRI)",
      "effect": "Při současném užívání SSRI s klopidogrelem je třeba zvýšená opatrnost, protože SSRI ovlivňují aktivaci krevních destiček a zvyšují riziko krvácení.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:3239",
      "drug": "Rifampicin",
      "effect": "Rifampicin silně aktivuje CYP2C19, a tím může zvýšit hladinu aktivního metabolitu klopidogrelu, zesílit inhibici krevních destiček a zejména zvýšit riziko krvácení. Současnému užívání je třeba se vyhnout.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cyp2c19_inhibitor",
      "drug_class": "Silné nebo středně silné inhibitory CYP2C19",
      "effect": "Mohou snížit hladinu aktivního metabolitu klopidogrelu; klinický význam této interakce není jasný. Z preventivních důvodů se současnému užívání vyhněte. Patří sem například omeprazol, esomeprazol, fluvoxamin, fluoxetin, moklobemid, vorikonazol, flukonazol, tiklopidin, karbamazepin a efavirenz.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },

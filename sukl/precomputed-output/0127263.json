  "side_effects": [
    {
      "ctcae": "Rash maculo-papular",
      "frequency": "common",
      "label": "Kožní vyrážka; v PIL častá, ve SPC častá.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": null,
        "min_severity": 1
      }
    },
    {
      "ctcae": "Stevens-Johnson syndrome",
      "frequency": "rare",
      "label": "Stevensův-Johnsonův syndrom nebo toxická epidermální nekrolýza. Vyrážce mohou předcházet příznaky podobné chřipce; mohou se objevit puchýře, olupování kůže nebo postižení sliznic. Riziko je nejvyšší v prvních týdnech léčby a může být vyšší u některých osob asijského původu a při chronickém onemocnění ledvin.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Pokud se objeví vyrážka nebo uvedené příznaky, zejména puchýře či postižení sliznic.",
        "min_severity": 1
      }
    },
    {
      "ctcae": "Immune system disorders - Other, specify",
      "frequency": "uncommon",
      "label": "Reakce z přecitlivělosti; mohou mít více podob. Závažná reakce může zahrnovat horečku, vyrážku, bolest kloubů a změny krevního obrazu či jaterních testů. Četnost výskytu je vyšší při poruše funkce ledvin nebo jater.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": null,
        "min_severity": 1
      }
    },
    {
      "ctcae": "Anaphylaxis",
      "frequency": "very_rare",
      "label": "Anafylaktická reakce; PIL mezi příklady závažné alergické reakce uvádí náhlou dušnost, třes, tíseň na hrudi nebo kolaps.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": null,
        "min_severity": 1
      }
    },
    {
      "ctcae": "Edema face",
      "frequency": "very_rare",
      "label": "Angioedém, někdy se známkami celkové reakce z přecitlivělosti.",
      "action": null,
      "action_condition": null
    },
    {

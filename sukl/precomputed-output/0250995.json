  "combinations": [
    {
      "class_id": "group:cyp3a4_inhibitor_strong",
      "drug_class": "Silné inhibitory CYP3A4",
      "effect": "Silné inhibitory CYP3A4, například erythromycin, ketokonazol, itrakonazol, ritonavir, indinavir a nefazodon, mohou zvýšit hladinu trazodonu v krvi. U ritonaviru 200 mg dvakrát denně se hladina zvýšila více než dvojnásobně a byly pozorovány nevolnost, synkopa a nízký krevní tlak. Společnému podávání se má pokud možno vyhnout; pokud je nezbytné, lékař zváží nižší dávku trazodonu.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:11589",
      "drug": "KARBAMAZEPIN",
      "effect": "Karbamazepin snižuje hladinu trazodonu v krvi; při dávce karbamazepinu 400 mg denně klesla hladina trazodonu o 76 % a jeho aktivního metabolitu o 60 %. Lékař má pacienta pečlivě sledovat a podle potřeby může upravit dávku trazodonu.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:N06AA",
      "drug_class": "Tricyklická antidepresiva",
      "effect": "Souběžné podávání tricyklických antidepresiv s trazodonem se nedoporučuje kvůli riziku interakcí; je třeba věnovat pozornost serotoninovému syndromu a nežádoucím účinkům na srdce a cévy.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:serotonergic",
      "drug_class": "Serotonergní léky včetně dalších antidepresiv a neuroleptik",
      "effect": "Při současném podávání trazodonu s dalšími serotonergními léky, například jinými antidepresivy nebo neuroleptiky, byly popsány případy serotoninového syndromu nebo neuroleptického maligního syndromu. U neuroleptik, u nichž je tento syndrom známým nežádoucím účinkem, byly popsány i smrtelné případy.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Inhibitory monoaminooxidázy (IMAO)",
      "effect": "Současné podávání trazodonu s IMAO nebo během dvou týdnů po ukončení léčby IMAO se nedoporučuje. Podávání IMAO během jednoho týdne po ukončení léčby trazodonem se také nedoporučuje.",
      "effect_type": null,
      "side_effects": []
    },
    {
      "class_id": "atc:N05AA",
      "drug_class": "Fenothiaziny",
      "effect": "Při současném podávání trazodonu s fenothiaziny, například chlorpromazinem, flufenazinem, levomepromazinem nebo perfenazinem, byla pozorována závažná závrať nebo pokles krevního tlaku při rychlém vzpřímení.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {

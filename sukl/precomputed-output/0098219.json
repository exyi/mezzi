    },
    {
      "ctcae": "Dizziness",
      "frequency": "very_common",
      "label": "Při dlouhodobé léčbě, zvláště u starších lidí, může zvýšené močení a ztráta elektrolytů způsobit oběhové potíže se závratěmi.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Headache",
      "frequency": "very_common",

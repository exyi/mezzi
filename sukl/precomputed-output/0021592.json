  "combinations": [
    {
      "class_id": "group:cns_depressant",
      "drug_class": "Léky tlumící centrální nervový systém (například opioidy, léky proti úzkosti, hypnotika a sedativa včetně benzodiazepinů, antipsychotika, anestetika, antiemetika, antidepresiva, antihistaminika a fenothiaziny)",
      "effect": "Současné užívání s Palladone SR může zesílit útlum centrálního nervového systému a zvýšit riziko sedace, útlumu dýchání, kómatu a úmrtí. Současné podávání se sedativy, jako jsou benzodiazepiny a jim podobné látky, je vyhrazeno pro situace, kdy není možná jiná léčba; lékař omezí dávku a délku léčby a zvolí nejnižší účinnou dávku na nejkratší možnou dobu. Pacient má být pečlivě sledován.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:N02BF",
      "drug_class": "Gabapentin a pregabalin",
      "effect": "Současné užívání opioidů s gabapentinem nebo pregabalinem zvyšuje riziko předávkování opioidy, útlumu dýchání a úmrtí.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:N02A",
      "drug_class": "Jiná opioidní analgetika",
      "effect": "Současné užívání s dalšími opioidy může zvýšit tlumivý účinek na centrální nervový systém a riziko útlumu dýchání, nadměrného celkového útlumu, kómatu a úmrtí.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:C02K",
      "drug_class": "Inhibitory monoaminooxidázy (IMAO)",
      "effect": "Palladone SR se nesmí užívat současně s IMAO ani během 14 dnů po jejich vysazení.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "atc:V03AZ01",
      "drug": "ethanol",
      "effect": "Alkohol při užívání Palladone SR může zesílit ospalost a další nežádoucí účinky, například mělké dýchání s rizikem zástavy dechu a ztráty vědomí; současnému užívání je třeba se vyhnout.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    }
  ],

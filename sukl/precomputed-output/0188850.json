  "combinations": [
    {
      "class_id": null,
      "drug": "Methotrexate",
      "effect": "Při dávce methotrexátu vyšší než 15 mg týdně je současné užívání kontraindikováno: kyselina acetylsalicylová snižuje vylučování methotrexátu ledvinami a zvyšuje jeho krevní a krvetvornou toxicitu. Při dávce nižší než 15 mg týdně se může toxicita pro krvetvorbu také zvýšit; lékař může sledovat krevní obraz a funkci ledvin, zejména na začátku léčby, u starších lidí nebo při mírné poruše ledvin.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Léky ovlivňující srážení krve, včetně antikoagulancií, trombolytik, protidestičkových látek a protizánětlivých léků",
      "effect": "Současné užívání může zvýšit riziko krvácení. SPC tuto kombinaci nedoporučuje, pokud není nezbytně indikována; pokud se jí nelze vyhnout, lékař sleduje známky krvácení. Patří sem například warfarin, heparin, klopidogrel a dipyridamol.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },

      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug": "KETOKONAZOL",
      "effect": "Ketokonazol může inhibovat oxidaci bikalutamidu a teoreticky zvýšit jeho plazmatickou koncentraci, což by mohlo zvýraznit nežádoucí účinky; při souběžném podávání je nutná opatrnost.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {

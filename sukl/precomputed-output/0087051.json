  "combinations": [
    {
      "class_id": "group:cyp3a4_inhibitor",
      "drug_class": "Silné nebo středně silné inhibitory CYP3A4 a inhibitory transportních proteinů",
      "effect": "Mohou zvýšit hladinu atorvastatinu v krvi a riziko svalových nežádoucích účinků včetně myopatie a rhabdomyolýzy. Pokud se kombinaci nelze vyhnout, lékař zváží nižší počáteční a maximální dávku atorvastatinu a klinické sledování. Při elbasviru/grazopreviru nebo letermoviru nepřekračuje dávka atorvastatinu 20 mg denně; s letermovirem a cyklosporinem se souběžné užívání nedoporučuje.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inducer",
      "drug_class": "Induktory CYP3A4",
      "effect": "Efavirenz, rifampicin nebo třezalka mohou snížit hladinu atorvastatinu v krvi. U rifampicinu se doporučuje užít oba léky současně; opožděné užití atorvastatinu může jeho hladinu výrazně snížit. Lékař sleduje účinnost léčby.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:16464",
      "drug": "Cyklosporin",
      "effect": "Cyklosporin může zvýšit hladinu atorvastatinu v krvi a riziko myopatie. Pokud se kombinaci nelze vyhnout, lékař zváží nižší dávku atorvastatinu a klinické sledování.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:16464",
      "drug": "Kyselina fusidová",
      "effect": "Systémová kyselina fusidová se nesmí užívat současně s atorvastatinem ani 7 dní po ukončení léčby. Je-li systémová léčba kyselinou fusidovou nezbytná, léčba atorvastatinem se po tuto dobu přeruší; znovu ji lze zahájit 7 dní po poslední dávce kyseliny fusidové. Výjimečné souběžné podávání při závažné infekci lze zvážit jen pod pečlivým lékařským dohledem. Byla hlášena rhabdomyolýza včetně úmrtí.",
      "effect_type": "contraindicated",

  "combinations": [
    {
      "class_id": "group:cns_depressant",
      "drug_class": "Látky tlumící centrální nervový systém, včetně alkoholu a omamných látek",
      "effect": "Současné užívání s fentanylem může zesílit útlum centrálního nervového systému a způsobit útlum dechu, nízký krevní tlak, silnou sedaci, kóma nebo úmrtí. Současné předepisování je vyhrazeno pro případy bez jiné možnosti léčby; lékař má omezit dávku a dobu podávání a pacienta pečlivě sledovat.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:serotonergic",
      "drug_class": "Serotonergní léčivé přípravky, včetně SSRI, SNRI a IMAO",
      "effect": "Současné podávání s fentanylem může způsobit potenciálně život ohrožující serotoninový syndrom, a to i při doporučené dávce. Je nutná opatrnost a pečlivé sledování, zejména při zahájení léčby a změně dávky; při podezření na syndrom se fentanyl vysazuje. S IMAO se fentanyl nesmí užívat ještě 14 dní po jejich vysazení.",
      "effect_type": "increased_toxicity",
      "side_effects": [
        {
          "ctcae": "Serotonin syndrome",
          "frequency": null,
          "label": "Serotoninový syndrom při současném podávání serotonergních léků.",
          "action": null,
          "action_condition": null
        }
      ]
    },
    {
      "class_id": "group:cyp3a4_inhibitor",
      "drug_class": "Inhibitory CYP3A4",
      "effect": "Mohou zvýšit hladinu fentanylu v krvi, zesílit nebo prodloužit jeho léčebné i nežádoucí účinky a způsobit závažný útlum dechu. Současné užívání transdermálního fentanylu se nedoporučuje, pokud přínos nepřeváží riziko; při nevyhnutelné kombinaci je nutné pečlivé sledování a lékař může dávku fentanylu snížit nebo léčbu přerušit. První náplast se obvykle aplikuje nejdříve 2 dny po vysazení inhibitoru; po odstranění poslední náplasti se s inhibitorem obvykle čeká nejméně týden. U některých inhibitorů může být čekací doba delší.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inducer",
      "drug_class": "Induktory CYP3A4",
      "effect": "Mohou snížit hladinu fentanylu v krvi a oslabit jeho účinek. Lékař může dávku zvýšit nebo změnit léčbu. Při ukončení induktoru může hladina fentanylu následně stoupnout a zesílit jeho účinky včetně útlumu dechu; lékař může dávku snížit a pacienta pečlivě sledovat až do ustálení účinku.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Buprenorfin, nalbufin nebo pentazocin",
      "effect": "Tyto léky mohou částečně oslabit tlumení bolesti fentanylem a u člověka závislého na opioidech vyvolat abstinenční příznaky. Současné užívání se nedoporučuje.",
      "effect_type": "antagonism",
      "side_effects": []
    }
  ],

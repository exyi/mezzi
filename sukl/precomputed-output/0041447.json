  "side_effects": [
    {
      "ctcae": "Hepatitis",
      "frequency": "uncommon",
      "label": "Poškození jater, například zánět jater (hepatitida); může se projevit nevolností nebo zvracením, nechutenstvím, celkovou nevolností, horečkou, svěděním, zežloutnutím kůže či očního bělma nebo tmavou močí.",
      "action": "contact_doctor",
      "action_condition": null
    },
    {
      "ctcae": "Gastric ulcer",
      "frequency": "uncommon",
      "label": "Žaludeční nebo dvanáctníkový vřed, který může způsobovat bolest žaludku a nepříjemný pocit mezi pupkem a hrudní kostí.",
      "action": "contact_doctor",
      "action_condition": null
    },
    {
      "ctcae": "Gastrointestinal hemorrhage",
      "frequency": "uncommon",
      "label": "Krvácení do žaludku nebo střev, které se může projevit tmavou dehtovitou stolicí nebo viditelným krvácením z konečníku.",
      "action": "contact_doctor",
      "action_condition": null
    },
    {
      "ctcae": "Seizure",
      "frequency": "uncommon",
      "label": "Záchvaty nebo křeče.",
      "action": "contact_doctor",
      "action_condition": null
    },
    {
      "ctcae": "Neuroleptic malignant syndrome",
      "frequency": "very_rare",
      "label": "Neuroleptický maligní syndrom: horečka se svalovou ztuhlostí, pocením nebo poruchou vědomí.",
      "action": "contact_doctor",
      "action_condition": null
    },
    {
      "ctcae": "Rhabdomyolysis",
      "frequency": "very_rare",
      "label": "Rozpad svalů (rabdomyolýza), který se může projevit slabostí, citlivostí nebo bolestí svalů; zvlášť závažné je, pokud se současně necítíte dobře, máte vysokou teplotu nebo tmavou moč. Může poškodit ledviny.",
      "action": "contact_doctor",
      "action_condition": null
    },
    {
      "ctcae": "Electrocardiogram QT corrected interval prolonged",
      "frequency": "not_known",
      "label": "Prodloužení QT intervalu, změna srdeční činnosti zjistitelná na EKG.",

    {
      "class_id": "group:cyp3a4_inhibitor",
      "drug_class": "Inhibitory CYP3A4",
      "effect": "Donepezil se odbourává mimo jiné přes CYP3A4. Ketokonazol, itrakonazol a erythromycin mohou jeho odbourávání zpomalit; ve studii u zdravých dobrovolníků ketokonazol zvýšil průměrné koncentrace donepezilu přibližně o 30 %. Při souběžném užívání těchto a dalších inhibitorů CYP3A4 je třeba opatrnosti.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {

  "combinations": [
    {
      "class_id": "group:cyp3a4_inducer",
      "drug_class": "Léky snižující hladinu cyklosporinu indukcí CYP3A4 a/nebo P-gp",
      "effect": "Tyto léky mohou snížit hladinu cyklosporinu v krvi a jeho účinek. Při zahájení nebo ukončení souběžné léčby může lékař, zejména u pacientů po transplantaci, kontrolovat hladinu cyklosporinu a podle potřeby upravit jeho dávku. U rifampicinu může být nutné dávku cyklosporinu zvýšit 3–5krát; oktreotid může snížit vstřebávání perorálního cyklosporinu, takže může být nutné zvýšení dávky přibližně o 50 % nebo přechod na nitrožilní podání. Přípravky s třezalkou tečkovanou se nesmějí užívat současně. Mezi příklady patří barbituráty, karbamazepin, oxkarbazepin, fenytoin, rifampicin, nafcilin, sulfadimidin podávaný nitrožilně, probukol, orlistat, tiklopidin, sulfinpyrazon, terbinafin a bosentan.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inhibitor",
      "drug_class": "Léky zvyšující hladinu cyklosporinu inhibicí CYP3A4 a/nebo P-gp",
      "effect": "Tyto léky mohou zvýšit hladinu cyklosporinu v krvi a jeho expozici. Při zahájení nebo ukončení souběžné léčby může lékař, zejména u pacientů po transplantaci, kontrolovat hladinu cyklosporinu a podle potřeby upravit jeho dávku; u ostatních pacientů se doporučuje pečlivě sledovat funkci ledvin a možné nežádoucí účinky. Erytromycin může zvýšit expozici 4–7krát a někdy vést k poškození ledvin; klaritromycin ji může zdvojnásobit a azitromycin zvýšit hladinu přibližně o 20 %. Ketokonazol, flukonazol, itrakonazol a vorikonazol mohou expozici více než zdvojnásobit. Dalšími příklady jsou nikardipin, metoklopramid, perorální antikoncepce, vysoké dávky methylprednisolonu, alopurinol, kyselina cholová a její deriváty, inhibitory proteázy, imatinib, kolchicin a nefazodon.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:pgp_inhibitor",
      "drug": "kanabidiol",
      "effect": "Kanabidiol může inhibovat střevní P-gp a zvýšit biologickou dostupnost cyklosporinu a jeho hladinu v krvi. Je třeba pečlivě sledovat nežádoucí účinky; u pacientů po transplantaci se mají sledovat minimální hladiny cyklosporinu v krvi a podle potřeby upravit dávku. U ostatních pacientů může lékař zvážit sledování hladiny a případnou úpravu dávky.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:L04AD02",
      "drug": "takrolimus",
      "effect": "Cyklosporin a takrolimus se nemají užívat současně, protože se zvyšuje riziko poškození ledvin a dochází k farmakokinetické interakci přes CYP3A4 a/nebo P-gp.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "group:nephrotoxic",
      "drug_class": "Léky s možným synergickým účinkem poškozujícím ledviny",
      "effect": "Při současném užívání s cyklosporinem se může zvýšit riziko poškození ledvin. Lékař má pečlivě sledovat funkci ledvin; při jejím významném zhoršení může snížit dávku souběžného léku nebo zvážit jinou léčbu. Mezi příklady patří aminoglykosidy (včetně gentamicinu a tobramycinu), amfotericin B, ciprofloxacin, vankomycin, trimetoprim se sulfamethoxazolem, fibráty, nesteroidní protizánětlivé léky (včetně diklofenaku, naproxenu a sulindaku), melfalan, antagonisté H2 receptorů (například cimetidin a ranitidin) a methotrexát.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:C10AA",
      "drug_class": "Statiny (inhibitory HMG-CoA reduktázy)",
      "effect": "Cyklosporin může zvýšit expozici statinů a riziko toxických účinků. Jejich dávka má být snížena a u některých statinů se má souběžnému užití zabránit podle jejich informací o přípravku. Lékař má sledovat klinické projevy toxicity; při známkách myopatie nebo zvýšeném riziku závažného poškození ledvin včetně selhání ledvin při rhabdomyolýze se má léčba statinem dočasně vysadit nebo přerušit. Uváděné zvýšení expozice: atorvastatin 8–10krát, simvastatin 6–8krát, fluvastatin 2–4krát, lovastatin 5–8krát, pravastatin 5–10krát, rosuvastatin 5–10krát a pitavastatin 4–6krát.",

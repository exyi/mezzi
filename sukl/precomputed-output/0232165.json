  "side_effects": [
    {
      "ctcae": "Rash maculo-papular",
      "frequency": "very_common",
      "label": "Kožní reakce různé závažnosti, například vyrážka, svědění nebo kopřivka; obvykle mírné a často během léčby vymizí.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Arthralgia",
      "frequency": "common",
      "label": "Bolesti kloubů; mohou se postupně objevit i po několika měsících léčby.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Blood and lymphatic system disorders - Other, specify",
      "frequency": "uncommon",
      "label": "Agranulocytóza, závažný pokles určitého typu bílých krvinek; může se objevit týdny až měsíce po zahájení nebo opětovném zahájení léčby.",
      "action": "contact_doctor",
      "action_condition": {
        "patient_guide": "Zánět sliznice v ústech, bolest v krku nebo horečka, zvláště v prvních týdnech léčby.",
        "min_severity": 1
      }
    },
    {
      "ctcae": "Dysgeusia",
      "frequency": "rare",
      "label": "Porucha nebo ztráta chuti; návrat k normálu může po vysazení trvat několik týdnů.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Fever",
      "frequency": "rare",
      "label": "Horečka.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Thrombocytopenia",
      "frequency": "very_rare",
      "label": "Snížení počtu krevních destiček.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Blood and lymphatic system disorders - Other, specify",
      "frequency": "very_rare",
      "label": "Snížení počtu krevních buněk (pancytopenie).",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Lymph gland infection",
      "frequency": "very_rare",
      "label": "Onemocnění lymfatických uzlin (generalizovaná lymfadenopatie).",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Hypoglycemia",
      "frequency": "very_rare",
      "label": "Autoimunitní inzulínový syndrom s výrazným poklesem hladiny cukru v krvi.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Peripheral nerve infection",
      "frequency": "very_rare",
      "label": "Zánět nervů (neuritida) nebo více nervů (polyneuropatie).",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Salivary gland infection",
      "frequency": "very_rare",
      "label": "Akutní otok slinné žlázy.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Hepatitis",
      "frequency": "very_rare",
      "label": "Porucha funkce jater nebo zánět jater, včetně cholestatické žloutenky či toxické hepatitidy; příznaky obvykle po ukončení léčby vymizí.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Dermatitis",
      "frequency": "very_rare",
      "label": "Závažné alergické kožní reakce, včetně celkové dermatitidy; byly hlášeny také Stevensův–Johnsonův syndrom, vypadávání vlasů a lupus vyvolaný lékem.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Alopecia",
      "frequency": "very_rare",
      "label": "Vypadávání vlasů.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Stevens-Johnson syndrome",
      "frequency": "very_rare",
      "label": "Stevensův–Johnsonův syndrom, závažná alergická kožní reakce.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Pancreatitis",
      "frequency": "not_known",
      "label": "Akutní zánět slinivky břišní.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Horečka nebo bolest břicha.",
        "min_severity": 1
      }
    },
    {
      "ctcae": "Vasculitis",
      "frequency": "not_known",
      "label": "Zánět cév; příznaky po přerušení léčby obvykle vymizí.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Weight gain",
      "frequency": null,
      "label": "Přírůstek tělesné hmotnosti při léčbě může souviset s normalizací zvýšené spotřeby energie při hypertyreóze.",
      "action": null,
      "action_condition": null
    }
  ],
  "combinations": [
    {
      "class_id": null,
      "drug": "Jód",
      "effect": "Příjem jódu mění odpověď štítné žlázy na thiamazol: nedostatek jódu ji zvyšuje a nadbytek snižuje. Lékař upravuje dávku podle příjmu jódu a funkce štítné žlázy.",
      "effect_type": "changed_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:B01A",
      "drug_class": "Antikoagulancia",
      "effect": "Po normalizaci funkce štítné žlázy může účinek antikoagulancií zeslábnout, protože hypertyreóza zvyšuje jejich aktivitu; lékař může upravit jejich dávkování.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    }
  ],
  "usage": "Používá se k léčbě nebo prevenci nadměrné tvorby hormonů štítné žlázy.",

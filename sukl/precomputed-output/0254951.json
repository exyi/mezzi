  "combinations": [
    {
      "class_id": null,
      "drug": "deferoxamin",
      "effect": "Kyselina askorbová v přípravku Cyclo 3 Fort může při současném užívání s deferoxaminem způsobit abnormální srdeční funkci nebo akutní srdeční selhání, obvykle vratné po vysazení vitaminu C. Současné užívání vyžaduje opatrnost a sledování srdeční funkce lékařem.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug": "deferipron",
      "effect": "Při současném užívání kyseliny askorbové v přípravku Cyclo 3 Fort s deferipronem je nutná opatrnost kvůli možnému riziku abnormální srdeční funkce nebo akutního srdečního selhání; riziko je odvozeno z interakce s deferoxaminem. Srdeční funkci sleduje lékař.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    }
  ],

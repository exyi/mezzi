    {
      "class_id": null,
      "drug_class": "Inhibitory monoaminooxidázy (IMAO)",
      "effect": "Současné užívání může vyvolat závažné nežádoucí účinky včetně serotoninového syndromu. Citalopram se nesmí užívat s IMAO; výjimkou je selegilin v dávce nejvýše 10 mg denně. Po vysazení nevratného IMAO vyčkejte 14 dní, po citalopramu 7 dní; u reverzibilního IMAO dodržte dobu uvedenou v jeho předpisových informacích.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "group:qt_prolonging",
      "drug_class": "Léčivé přípravky prodlužující QT interval",
      "effect": "Současné užívání je kontraindikováno kvůli možnému součtu účinků na QT interval. Patří sem mimo jiné antiarytmika tříd IA a III, některá antipsychotika, tricyklická antidepresiva, některá antibiotika a antihistaminika.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "substance:8217",

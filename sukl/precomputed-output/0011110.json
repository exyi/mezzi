    {
      "class_id": "group:cyp3a4_inhibitor",
      "drug_class": "Inhibitory CYP3A4, včetně makrolidových antibiotik, azolových antimykotik, inhibitorů proteáz, cimetidinu a grapefruitové šťávy",
      "effect": "Inhibice CYP3A4 může snížit odbourávání oxykodonu, snížit jeho clearance a zvýšit jeho plazmatické koncentrace; může být nutná úprava dávky oxykodonu lékařem. U perorálního oxykodonu itrakonazol 200 mg denně po 5 dnů zvýšil AUC průměrně 2,4krát, vorikonazol 200 mg dvakrát denně po 4 dny 3,6krát, telithromycin 800 mg denně po 4 dny 1,8krát a grapefruitová šťáva 200 ml třikrát denně po 5 dnů 1,7krát.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inducer",
      "drug_class": "Induktory CYP3A4, včetně rifampicinu, karbamazepinu, fenytoinu a třezalky tečkované",
      "effect": "Indukce CYP3A4 může urychlit odbourávání oxykodonu, zvýšit jeho clearance a snížit jeho plazmatické koncentrace; může být nutná úprava dávky oxykodonu lékařem. Třezalka tečkovaná 300 mg třikrát denně po 15 dnů snížila AUC perorálního oxykodonu průměrně přibližně o 50 % a rifampicin 600 mg denně po 7 dnů přibližně o 86 %.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },

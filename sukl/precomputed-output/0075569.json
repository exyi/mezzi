    {
      "ctcae": "Blood and lymphatic system disorders - Other, specify",
      "frequency": "very_rare",
      "label": "Změny krevního obrazu: aplastická anémie, agranulocytóza, pancytopenie, neutropenie, leukopenie nebo trombocytopenie. Při výrazném zhoršení celkového stavu, zejména s horečkou nebo bolestí v krku či ústech, nevysvětleném krvácení, modřinách, fialových skvrnách, únavě či bledosti ihned kontaktujte lékaře a přestaňte přípravek používat.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Při výrazném zhoršení celkového stavu, zejména s horečkou nebo bolestí v krku či ústech, nevysvětleném krvácení, modřinách, fialových skvrnách, únavě nebo bledosti",
        "min_severity": null
      }
    },
    {
      "ctcae": "Allergic reaction",
      "frequency": "very_rare",
      "label": "Celková alergická reakce, například kožní vyrážka, horečka, bolesti kloubů nebo dýchací potíže; může se objevit také celkový zánět tlustého střeva se silným průjmem a bolestmi břicha. Ihned kontaktujte lékaře a přestaňte čípky používat.",
      "action": "discontinue_treatment",
      "action_condition": null
    },
    {
      "ctcae": "Colitis",
      "frequency": "very_rare",
      "label": "Celkový zánět tlustého střeva se silným průjmem a bolestmi břicha",
      "action": "discontinue_treatment",
      "action_condition": null
    },
    {
      "ctcae": "Myocarditis",
      "frequency": "rare",
      "label": "Zánět srdečního svalu z přecitlivělosti; může se projevit dušností, bolestí na hrudi, nepravidelným srdečním tepem nebo otoky končetin. Ihned kontaktujte lékaře a přestaňte přípravek používat.",
      "action": "discontinue_treatment",
      "action_condition": null
    },
    {
      "ctcae": "Pericarditis",
      "frequency": "rare",
      "label": "Zánět osrdečníku z přecitlivělosti; může se projevit dušností, bolestí na hrudi, nepravidelným srdečním tepem nebo otoky končetin. Ihned kontaktujte lékaře a přestaňte přípravek používat.",
      "action": "discontinue_treatment",
      "action_condition": null
    },
    {
      "ctcae": "Renal and urinary disorders - Other, specify",
      "frequency": "very_rare",
      "label": "Porucha funkce ledvin, včetně akutního nebo chronického zánětu ledvin a selhání ledvin. Při zhoršení funkce ledvin se má přípravek okamžitě vysadit.",
      "action": "discontinue_treatment",
      "action_condition": null
    },
    {
      "ctcae": "Renal calculi",
      "frequency": "not_known",
      "label": "Ledvinové kameny; mohou způsobit náhlou bolest v boku. Dbejte na dostatečný příjem tekutin.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Stevens-Johnson syndrome",
      "frequency": "not_known",
      "label": "Závažná kožní reakce: vyrážka s načervenalými, nevystupujícími skvrnami, které mohou vypadat jako terče nebo kruhy a mít puchýřek uprostřed; olupování kůže a vřídky v ústech, hrdle, nose, na pohlavních orgánech nebo očích, rozsáhlá vyrážka, horečka a zvětšené uzliny. Často jí předchází horečka a příznaky podobné chřipce. Přestaňte přípravek používat a okamžitě vyhledejte lékařskou pomoc.",
      "action": "emergency",
      "action_condition": null
    },
    {
      "ctcae": "Toxic epidermal necrolysis",
      "frequency": "not_known",
      "label": "Závažná kožní reakce s rozsáhlou vyrážkou, puchýři a olupováním kůže, případně vřídky na sliznicích. Přestaňte přípravek používat a okamžitě vyhledejte lékařskou pomoc.",
      "action": "emergency",
      "action_condition": null
    },
    {
      "ctcae": null,
      "frequency": "not_known",
      "label": "Poléková reakce s eozinofilií a systémovými příznaky (DRESS), závažná kožní reakce. Při příznacích závažné kožní reakce uvedených výše přestaňte přípravek používat a okamžitě vyhledejte lékařskou pomoc.",
      "action": "emergency",
      "action_condition": null
    },
    {
      "ctcae": "Intracranial hypertension",
      "frequency": "not_known",
      "label": "Zvýšený tlak uvnitř lebky (idiopatická intrakraniální hypertenze) se může projevit silnou nebo opakující se bolestí hlavy, poruchami vidění nebo zvoněním či hučením v uších. Při těchto příznacích okamžitě kontaktujte lékaře.",
      "action": "contact_doctor",
      "action_condition": null
    },
    {
      "ctcae": "Dermatitis",

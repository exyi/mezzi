  "combinations": [
    {
      "class_id": "group:qt_prolonging",
      "drug_class": "Léky prodlužující QTc interval",
      "effect": "Donepezil byl spojován s prodloužením QTc a torsade de pointes. Při kombinaci s léky, o nichž je známo, že prodlužují QTc, se doporučuje opatrnost a může být nutné klinické sledování včetně EKG. Příklady zahrnují chinidin, amiodaron, sotalol, citalopram, escitalopram, amitriptylin, některá antipsychotika a některá antibiotika.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inhibitor",
      "drug_class": "Inhibitory CYP3A4",
      "effect": "Mohou inhibovat metabolismus donepezilu a zvýšit jeho koncentraci. Ketokonazol zvýšil u zdravých dobrovolníků průměrnou koncentraci donepezilu přibližně o 30 %. Příklady zahrnují itrakonazol a erythromycin; kombinace se mají používat opatrně, protože význam inhibičního vlivu není znám.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:cyp2d6_inhibitor",
      "drug_class": "Inhibitory CYP2D6",
      "effect": "Mohou inhibovat metabolismus donepezilu; fluoxetin je uveden jako příklad. Kombinace se má používat opatrně, protože význam inhibičního vlivu není znám.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inducer",
      "drug_class": "Induktory enzymů včetně CYP3A4",
      "effect": "Rifampicin, fenytoin, karbamazepin a alkohol mohou snižovat hladinu donepezilu. Kombinace se mají používat opatrně, protože význam indukčního vlivu není znám.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {

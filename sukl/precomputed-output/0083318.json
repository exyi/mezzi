  "combinations": [
    {
      "class_id": "group:pgp_inhibitor",
      "drug_class": "Inhibitory P-glykoproteinu",
      "effect": "Mohou zvýšit vstřebávání nebo snížit vylučování digoxinu ledvinami, a tím zvýšit jeho hladinu v krvi a riziko toxicity. Lékař může sledovat hladinu digoxinu a podle potřeby snížit jeho dávku. Mezi uvedené příklady patří lapatinib, vandetanib, vemurafenib, verapamil, diltiazem, chinidin, amiodaron, propafenon, karvedilol, telmisartan, kaptopril, ritonavir, sachinavir, tetracyklin, erytromycin, klaritromycin, gentamicin, atorvastatin, omeprazol a indometacin; také tolvaptan, spironolakton, tikagrelor, ranolazin, cyklosporin a chinin.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:C07",
      "drug_class": "Betablokátory",
      "effect": "Zpomalují AV vedení a srdeční frekvenci společně s digoxinem, což může zvýšit riziko pomalého tepu a srdeční blokády. Při kombinaci se doporučuje opatrnost; lékař má sledovat nežádoucí účinky. Karvedilol může navíc zvýšit hladinu digoxinu v krvi.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Nedihydropyridinové blokátory kalciových kanálů, například verapamil a diltiazem",
      "effect": "Zpomalují AV vedení a srdeční frekvenci společně s digoxinem, což může zvýšit riziko pomalého tepu a srdeční blokády. Při kombinaci se doporučuje opatrnost; lékař má sledovat nežádoucí účinky. Verapamil a diltiazem mohou také zvýšit hladinu digoxinu v krvi.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Intravenózní vápník, sukcinylcholin, sympatomimetika a antiarytmika",
      "effect": "V kombinaci s digoxinem mohou zvýšit riziko poruch srdečního rytmu. Pokud možno se jim lékař vyhne, nebo je podá s opatrností a pečlivě sleduje nežádoucí účinky. Mezi uvedené antiarytmické přípravky patří chinidin, propafenon a amiodaron.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:C03",
      "drug_class": "Diuretika, včetně těch, která snižují draslík, i draslík šetřících diuretik",
      "effect": "Při kombinaci s digoxinem je třeba sledovat hladiny elektrolytů v krvi, protože jejich změny mohou zhoršit toxicitu digoxinu a zvýšit riziko poruch srdečního rytmu. Při současném užívání diuretika s inhibitorem ACE nebo bez něj může lékař předepsat nižší dávku digoxinu.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:H02",
      "drug_class": "Kortikosteroidy",
      "effect": "Při kombinaci s digoxinem je třeba sledovat hladiny elektrolytů v krvi.",
      "effect_type": null,
      "side_effects": []
    },
    {
      "class_id": "atc:C10AC",
      "drug_class": "Aniontové iontoměniče, včetně cholestyraminu a kolestipolu",
      "effect": "Mohou snížit vstřebávání a hladinu digoxinu v těle, a tím jeho účinek.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Léky snižující vstřebávání digoxinu",
      "effect": "Živočišné uhlí, vláknina, antacida, léky proti průjmu, metoklopramid, neomycin, sulfasalazin, kyselina para-aminosalicylová, gliadinové peptidy, rifampicin, fenytoin a aktinoterapie mohou snížit vstřebávání a hladinu digoxinu v těle, a tím jeho účinek.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {

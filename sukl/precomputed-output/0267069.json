    {
      "ctcae": "Hypersensitivity",
      "frequency": "not_known",
      "label": "Přecitlivělost; při používání byly hlášeny generalizovaná vyrážka, angioedém, otok rtů, sliznice úst nebo obličeje, pálení či otok kolem očí a astmatické obtíže. Frekvenci nelze z dostupných údajů určit.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": null,
        "min_severity": 1
      }
    },
    {
      "ctcae": "Anaphylaxis",
      "frequency": "not_known",
      "label": "Anafylaktická reakce včetně anafylaktického šoku; při šoku byly hlášeny také bušení srdce a nízký krevní tlak. Frekvenci nelze z dostupných údajů určit.",
      "action": "emergency",
      "action_condition": {
        "patient_guide": null,
        "min_severity": 1
      }
    },
    {
      "ctcae": "Colonic stenosis",
      "frequency": "not_known",
      "label": "Jizvení nebo zúžení střeva (fibrotizující kolonopatie), zejména u pacientů s cystickou fibrózou při dávce nad 10 000 jednotek lipázy/kg tělesné hmotnosti denně; hlášeny byly striktury v oblasti přechodu tenkého a tlustého střeva i v tlustém střevě. Frekvenci nelze z dostupných údajů určit. Při silné bolesti břicha, zácpě, pocitu na zvracení nebo zvracení informujte ihned lékaře.",
      "action": "contact_doctor",
      "action_condition": {
        "patient_guide": "Při silné bolesti břicha, zácpě, pocitu na zvracení nebo zvracení.",
        "min_severity": 2
      }
    },
    {
      "ctcae": "Mucositis oral",
      "frequency": null,

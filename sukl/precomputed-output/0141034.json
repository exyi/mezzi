  "combinations": [
    {
      "class_id": "atc:B01AA",
      "drug_class": "Perorální antikoagulancia",
      "effect": "Současné užívání klopidogrelu s perorálními antikoagulancii může zvýšit intenzitu krvácení; kombinace se nedoporučuje. U warfarinu 75 mg klopidogrelu denně nemění farmakokinetiku S-warfarinu ani INR, ale nezávislé účinky na zástavu krvácení zvyšují riziko krvácení.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:B01AC06",
      "drug_class": "Kyselina acetylsalicylová",
      "effect": "Klopidogrel může zesílit účinek kyseliny acetylsalicylové na shlukování krevních destiček; kombinace může zvýšit riziko krvácení a vyžaduje opatrnost. Příležitostné užití do 1 000 mg za 24 hodin většinou potíže nezpůsobí; delší užívání za jiných podmínek konzultujte s lékařem. Kombinace se používá v indikacích a po dobu uvedenou lékařem.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:B01AB01",
      "drug_class": "Heparin",
      "effect": "Současné podání může farmakodynamicky zvýšit riziko krvácení; vyžaduje opatrnost. V klinické studii nebylo nutné upravovat dávku heparinu a jeho účinek na srážení krve se nezměnil.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:M01A",
      "drug_class": "Nesteroidní protizánětlivé léky, včetně inhibitorů COX-2",
      "effect": "Kombinace může zvýšit riziko krvácení, zejména do trávicího traktu; současné užívání vyžaduje opatrnost. U naproxenu bylo zjištěno zvýšení skrytých ztrát krve do trávicího traktu; zda se riziko týká všech těchto léků, není jasné.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:serotonergic",
      "drug_class": "Selektivní inhibitory zpětného vychytávání serotoninu (SSRI)",
      "effect": "SSRI ovlivňují aktivaci krevních destiček a mohou zvýšit riziko krvácení při současném užívání s klopidogrelem; je nutná zvýšená opatrnost.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:J04AB02",
      "drug": "Rifampicin",
      "effect": "Rifampicin silně indukuje CYP2C19, což zvyšuje hladinu aktivního metabolitu klopidogrelu a může zesílit inhibici krevních destiček a zejména riziko krvácení. Současnému užívání je třeba se vyhnout.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cyp2c19_inhibitor",
      "drug_class": "Silné nebo středně silné inhibitory CYP2C19",
      "effect": "Mohou snížit hladinu aktivního metabolitu klopidogrelu; klinický význam této interakce není jasný. Z preventivních důvodů se současnému užívání vyhněte. Patří sem například omeprazol, esomeprazol, fluvoxamin, fluoxetin, moklobemid, vorikonazol, flukonazol, tiklopidin, karbamazepin a efavirenz.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:3239",
      "drug": "Klopidogrel-sulfát",
      "effect": "Klopidogrel 300 mg zvýšil expozici rosuvastatinu 2krát (AUC) a 1,3krát (Cmax); opakované podávání klopidogrelu 75 mg zvýšilo AUC rosuvastatinu 1,4krát bez vlivu na Cmax.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {

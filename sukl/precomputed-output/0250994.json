  "combinations": [
    {
      "class_id": "group:cyp3a4_inhibitor_strong",
      "drug_class": "Silné inhibitory CYP3A4",
      "effect": "Mohou podstatně zvýšit hladinu trazodonu v krvi. Ritonavir 200 mg 2× denně zvýšil hladinu více než dvojnásobně a byly hlášeny nevolnost, mdloba a nízký tlak. Pokud je souběh nutný, lékař zváží nižší dávku trazodonu; společnému podávání se má pokud možno vyhnout.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:11589",
      "drug": "Karbamazepin",
      "effect": "Při souběžném užívání 400 mg denně snížil hladinu trazodonu o 76 % a jeho aktivního metabolitu o 60 %. Lékař má pacienta pečlivě sledovat a podle potřeby může zvýšit dávku trazodonu.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:11589",
      "drug": "Fluoxetin",
      "effect": "Vzácně byly při souběžném užívání hlášeny vyšší hladiny trazodonu a nežádoucí účinky. Mechanismus není zcela znám; nelze vyloučit ani serotoninový syndrom.",
      "effect_type": "changed_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:N06AA",
      "drug_class": "Tricyklická antidepresiva",
      "effect": "Kvůli riziku interakcí se nemají užívat současně s trazodonem; je třeba brát v úvahu serotoninový syndrom a srdečně-cévní nežádoucí účinky.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "atc:N06A",
      "drug_class": "Inhibitory monoaminooxidázy (IMAO)",
      "effect": "Současné užívání s trazodonem ani užívání během dvou týdnů po ukončení IMAO se nedoporučuje. IMAO se také nedoporučuje nasadit během týdne po ukončení trazodonu.",
      "effect_type": null,
      "side_effects": []
    },
    {

  "combinations": [
    {
      "class_id": null,
      "drug_class": "Inhibitory MAO včetně selegilinu nad 10 mg denně",
      "effect": "Současné užívání může vyvolat závažné nežádoucí účinky včetně serotoninového syndromu. Citalopram je kontraindikován během užívání a v uvedených intervalech po ukončení léčby: po ireverzibilních IMAO 14 dní, po reverzibilních IMAO podle jejich informací; po citalopramu je třeba před zahájením IMAO vyčkat 7 dní. U linezolidu je kombinace kontraindikována, pokud není možné pečlivé sledování krevního tlaku.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "group:qt_prolonging",
      "drug_class": "Léčivé přípravky prodlužující QT interval",
      "effect": "Současné užívání citalopramu a přípravků prodlužujících QT interval je kontraindikováno, protože nelze vyloučit sčítání účinku na QT interval. Patří sem mimo jiné antiarytmika tříd IA a III, některá antipsychotika, tricyklická antidepresiva, některá antimikrobiální léčiva a antihistaminika.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {

  "combinations": [
    {
      "class_id": "group:cyp3a4_inhibitor",
      "drug_class": "Inhibitory CYP3A4",
      "effect": "Mohou několikanásobně zvýšit systémovou dostupnost budesonidu a riziko systémových nežádoucích účinků kortikosteroidů. Kombinaci je třeba vyloučit, pokud její přínos nepřeváží zvýšené riziko; při nezbytném souběhu má lékař pacienta sledovat, prodloužit odstup mezi podáním na maximum a zvážit snížení dávky budesonidu. Patří sem ketokonazol, itrakonazol a inhibitory proteáz; příbalová informace uvádí také některé léky proti HIV, například ritonavir a kobicistat.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:5362",
      "drug": "Grepová šťáva",
      "effect": "Grepová šťáva inhibuje CYP3A4 a může zvýšit systémovou dostupnost perorálního budesonidu; po vypití značného objemu se zvýšila asi dvojnásobně. Při léčbě je třeba vyloučit pravidelnou konzumaci grepů a pití grepové šťávy. Příbalová informace upozorňuje, že grepová šťáva může ovlivnit účinek přípravku.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inducer",
      "drug_class": "Induktory CYP3A4",
      "effect": "Mohou snížit expozici budesonidu, což může vést k potřebě zvýšit jeho dávku. Příkladem je karbamazepin.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:G03C",
      "drug_class": "Estrogeny",
      "effect": "U žen užívajících estrogeny byly pozorovány zvýšené plazmatické koncentrace a zvýšená účinnost kortikosteroidů. Příbalová informace tuto interakci uvádí obecně; SPC upřesňuje, že nízkodávkovaná perorální antikoncepce, která zvýšila koncentrace prednisolonu více než dvojnásobně, neměla vliv na koncentrace perorálního budesonidu.",
      "effect_type": "increased_exposure",
      "side_effects": []
    }
  ],
  "usage": "Entocort léčí Crohnovu chorobu v oblasti konce tenkého a začátku tlustého střeva a mikroskopickou kolitidu.",

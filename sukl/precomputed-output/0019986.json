  "side_effects": [
    {
      "ctcae": "Stevens-Johnson syndrome",
      "frequency": "not_known",
      "label": "Závažná kožní vyrážka se skvrnami, puchýři, olupováním kůže a vřídky v ústech, nose, hrdle, na genitáliích nebo v očích; může jí předcházet horečka či příznaky podobné chřipce (Stevensův–Johnsonův syndrom).",
      "action": "discontinue_treatment",
      "action_condition": null
    },
    {
      "ctcae": "Toxic epidermal necrolysis",
      "frequency": "not_known",
      "label": "Závažná kožní vyrážka s puchýři a olupováním kůže (toxická epidermální nekrolýza).",
      "action": "discontinue_treatment",
      "action_condition": null
    },
    {
      "ctcae": "Drug reaction with eosinophilia and systemic symptoms",
      "frequency": "not_known",
      "label": "Rozsáhlá vyrážka, vysoká horečka a zvětšené mízní uzliny (DRESS).",
      "action": "discontinue_treatment",
      "action_condition": null
    },
    {
      "ctcae": "Pancreatitis",
      "frequency": "not_known",
      "label": "Akutní zánět slinivky břišní: úporná bolest břicha, nevolnost a zvracení.",
      "action": "contact_doctor",
      "action_condition": {
        "patient_guide": "Pokud máte úpornou bolest břicha, nevolnost a zvracení.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Dyspnea",
      "frequency": "common",
      "label": "Dušnost; závažné potíže s dýcháním mohou vyžadovat naléhavou intenzivní péči.",
      "action": "contact_doctor",
      "action_condition": {
        "patient_guide": "Pokud máte potíže s dýcháním.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Respiratory depression",
      "frequency": "rare",
      "label": "Mělké nebo utlumené dýchání.",
      "action": "contact_doctor",
      "action_condition": {
        "patient_guide": "Pokud máte potíže s dýcháním.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Anaphylaxis",
      "frequency": "not_known",
      "label": "Závažná alergická reakce s obtížným dýcháním, otokem rtů, hrdla nebo jazyka a nízkým krevním tlakem; vyžaduje akutní léčbu.",
      "action": "discontinue_treatment",
      "action_condition": null
    },
    {
      "ctcae": "Allergic reaction",
      "frequency": "not_known",
      "label": "Závažná alergická reakce, která může postihnout kůži, játra nebo krvinky: může se objevit vyrážka či zarudnutí, vypadávání vlasů, kopřivka, horečka, přetrvávající otok uzlin, otok rtů, obličeje či jazyka, žloutenka, neobvyklé modřiny nebo krvácení, výrazná únava či slabost, bolest svalů nebo časté infekce.",
      "action": "contact_doctor",
      "action_condition": {
        "patient_guide": "Pokud se objeví některý z uvedených příznaků závažné alergické reakce.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Suicidal ideation",
      "frequency": "not_known",
      "label": "Myšlenky na sebepoškození nebo sebevraždu.",
      "action": "contact_doctor",
      "action_condition": {
        "patient_guide": "Pokud se u vás kdykoli objeví myšlenky na sebepoškození nebo sebevraždu.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Rhabdomyolysis",
      "frequency": "not_known",
      "label": "Rozklad svalových vláken; mohou se objevit bolesti, citlivost nebo slabost svalů současně s horečkou či celkovou nevolností, tmavá moč a zvýšená hladina kreatinfosfokinázy v krvi. Může vést k poruše ledvin.",
      "action": "contact_doctor",
      "action_condition": {
        "patient_guide": "Pokud máte slabost, citlivost nebo bolest svalů a současně se necítíte dobře, případně máte horečku, nebo pozorujete změnu barvy moči.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Myositis",
      "frequency": "not_known",
      "label": "Myopatie se zvýšenou hladinou kreatinkinázy u pacientů s konečným stadiem selhání ledvin na hemodialýze.",
      "action": "contact_doctor",
      "action_condition": {
        "patient_guide": "Pokud podstupujete hemodialýzu a zaznamenáte bolest svalů nebo slabost.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Drug withdrawal syndrome",
      "frequency": "not_known",
      "label": "Příznaky z vysazení po ukončení léčby nebo snížení dávky: záchvaty, úzkost, poruchy spánku, nevolnost, bolest, pocení, třes, bolest hlavy, deprese, neobvyklé pocity, závrať a celková nevolnost. Obvykle se objeví do 48 hodin.",
      "action": "contact_doctor",
      "action_condition": {
        "patient_guide": "Pokud se po ukončení léčby nebo snížení dávky objeví tyto příznaky.",

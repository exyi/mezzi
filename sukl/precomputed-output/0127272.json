      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": null,
        "min_severity": 1
      }
    },
    {
      "ctcae": "Immune system disorders - Other, specify",
      "frequency": "uncommon",
      "label": "Přecitlivělost; při závažné reakci se mohou objevit horečka, vyrážka, bolest kloubů a změny krevního obrazu nebo jaterních testů.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Pokud se objeví vyrážka nebo jiné příznaky přecitlivělosti.",
        "min_severity": 1
      }
    },
    {
      "ctcae": "Stevens-Johnson syndrome",
      "frequency": "rare",
      "label": "Stevensův–Johnsonův syndrom nebo toxická epidermální nekrolýza; mohou se objevit puchýře, olupování kůže, vředy na sliznicích nebo červené a oteklé oči. Častěji u osob thajského, korejského nebo čínského původu; chronické onemocnění ledvin může riziko dále zvýšit.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Při vyrážce nebo příznacích uvedených v příbalové informaci.",

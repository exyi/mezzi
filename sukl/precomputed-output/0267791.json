  "combinations": [
    {
      "class_id": "group:cyp3a4_inhibitor_strong",
      "drug_class": "Silné inhibitory CYP3A4",
      "effect": "Mohou výrazně zvýšit hladinu trazodonu v krvi. Pokud je souběžné podávání nutné, lékař zváží nižší dávku trazodonu; společnému podávání se má pokud možno vyhnout. Mezi uvedené příklady patří erythromycin, ketokonazol, itrakonazol, ritonavir, indinavir a nefazodon.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:11589",
      "drug": "KARBAMAZEPIN",
      "effect": "Snižuje hladinu trazodonu a jeho aktivního metabolitu m-chlorofenylpiperazinu. Při dávce karbamazepinu 400 mg denně klesly jejich plazmatické koncentrace o 76 %, respektive 60 %; lékař má pacienta pečlivě sledovat a podle potřeby zvážit zvýšení dávky trazodonu.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:N06AA",
      "drug_class": "Tricyklická antidepresiva",
      "effect": "Současné podávání s trazodonem se kvůli riziku interakcí nedoporučuje. Je třeba vzít v úvahu serotoninový syndrom a kardiovaskulární nežádoucí účinky.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:serotonergic",
      "drug_class": "Serotonergní léčiva, včetně jiných antidepresiv (tricyklických, SSRI, SNRI a inhibitorů MAO) a neuroleptik",
      "effect": "Při současném podávání s trazodonem byly popsány případy serotoninového syndromu nebo maligního neuroleptického syndromu. Fatální maligní neuroleptický syndrom byl popsán při podávání s neuroleptiky. Trazodon se nemá podávat současně s inhibitory MAO ani během dvou týdnů po jejich vysazení; inhibitory MAO se nedoporučují ani během jednoho týdne po ukončení trazodonu.",
      "effect_type": "increased_toxicity",
      "side_effects": [
        {
          "ctcae": "Serotonin syndrome",
          "frequency": null,
          "label": "Při kombinaci s jinými serotonergními léky byly popsány případy serotoninového syndromu.",
          "action": null,
          "action_condition": null
        },
        {
          "ctcae": "Nervous system disorders - Other, specify",
          "frequency": null,
          "label": "Při kombinaci s neuroleptiky byl popsán maligní neuroleptický syndrom, někdy smrtelný.",
          "action": null,
          "action_condition": null
        }
      ]
    },
    {

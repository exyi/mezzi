  "combinations": [
    {
      "class_id": "atc:B01A",
      "drug_class": "Perorální antikoagulancia",
      "effect": "Současné podávání klopidogrelu a perorálních antikoagulancií se nedoporučuje, protože může zvýšit intenzitu krvácení. Warfarin v dávce klopidogrelu 75 mg denně neměnil farmakokinetiku S-warfarinu ani INR, ale jejich nezávislé účinky na srážení krve zvyšují riziko krvácení.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:B01AB",
      "drug_class": "Hepariny",
      "effect": "Při současném podávání klopidogrelu a heparinu může dojít k farmakodynamické interakci a zvýšit se riziko krvácení; kombinace vyžaduje opatrnost. Ve studii u zdravých dobrovolníků nebyla nutná úprava dávky heparinu a jeho účinek na srážení nebyl ovlivněn.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:B01AC",
      "drug_class": "Protidestičkové léky",
      "effect": "Klopidogrel s kyselinou acetylsalicylovou může zvýšit riziko krvácení a kombinace vyžaduje opatrnost. Trojitá protidestičková léčba klopidogrelem, kyselinou acetylsalicylovou a dipyridamolem se pro sekundární prevenci po akutní nekardioembolické cévní mozkové příhodě nebo TIA nedoporučuje.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:M01A",
      "drug_class": "Nesteroidní protizánětlivé léky včetně inhibitorů COX-2",
      "effect": "Současné podávání s klopidogrelem vyžaduje opatrnost kvůli možnému zvýšení rizika krvácení, zejména krvácení do trávicího traktu. U naproxenu bylo u zdravých dobrovolníků pozorováno zvýšení okultního krvácení do trávicího traktu; zda se riziko zvyšuje u všech léků této skupiny, není jasné.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:serotonergic",
      "drug_class": "Selektivní inhibitory zpětného vychytávání serotoninu (SSRI)",
      "effect": "SSRI ovlivňují aktivaci krevních destiček a zvyšují riziko krvácení; při současném podávání s klopidogrelem je třeba zvýšené opatrnosti.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cyp2c19_inhibitor",
      "drug_class": "Silné nebo středně silné inhibitory CYP2C19",
      "effect": "Mohou snížit tvorbu aktivního metabolitu klopidogrelu. Klinický význam této interakce není jasný; z preventivních důvodů se má současnému podávání vyhnout. Patří sem například omeprazol, esomeprazol, fluvoxamin, fluoxetin, moklobemid, vorikonazol, flukonazol, tiklopidin, karbamazepin a efavirenz. Omeprazol a esomeprazol snižují expozici aktivnímu metabolitu; pantoprazol nebo lansoprazol ji snižují méně a klopidogrel lze s pantoprazolem podávat.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {

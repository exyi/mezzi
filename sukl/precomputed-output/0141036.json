    },
    {
      "class_id": "substance:10648",
      "drug": "Kyselina acetylsalicylová",
      "effect": "Klopidogrel zesílil účinek kyseliny acetylsalicylové na agregaci krevních destiček vyvolanou kolagenem. Kombinace může zvýšit riziko krvácení a vyžaduje opatrnost. Příležitostné užití nejvýše 1 000 mg během 24 hodin obvykle nemá způsobit potíže; delší užívání za jiných podmínek konzultujte s lékařem.",
      "effect_type": "increased_toxicity",

  "combinations": [
    {
      "class_id": "atc:B01AA",
      "drug_class": "Perorální antikoagulancia",
      "effect": "Současné užívání s klopidogrelem může zvýšit intenzitu krvácení a nedoporučuje se. U warfarinu klopidogrel 75 mg denně neměnil farmakokinetiku S-warfarinu ani INR, ale kvůli nezávislému působení obou léků na srážení krve se riziko krvácení zvyšuje.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:B01AB",
      "drug_class": "Hepariny",
      "effect": "Při současném podávání s klopidogrelem může být vyšší riziko krvácení; kombinace vyžaduje opatrnost. U zdravých dobrovolníků nebylo nutné měnit dávku heparinu a jeho účinek na srážení krve nebyl klopidogrelem ovlivněn.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:B01AC",
      "drug_class": "Jiná protidestičková léčiva",
      "effect": "Souběžné užívání tiklopidinu nebo jiných protidestičkových léků s klopidogrelem může zvýšit riziko krvácení. Trojitá léčba klopidogrel + ASA + dipyridamol se pro sekundární prevenci cévní mozkové příhody nedoporučuje u pacientů s akutní nekardioembolickou ischemickou cévní mozkovou příhodou nebo TIA kvůli většímu a závažnějšímu krvácení.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:M01A",
      "drug_class": "Nesteroidní protizánětlivé léky (NSAID), včetně inhibitorů COX-2",
      "effect": "Současné užívání s klopidogrelem vyžaduje opatrnost kvůli riziku krvácení. Naproxen s klopidogrelem zvýšil skryté krvácení do trávicího traktu; není jasné, zda se toto riziko zvyšuje u všech NSAID.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:serotonergic",
      "drug_class": "Selektivní inhibitory zpětného vychytávání serotoninu (SSRI)",
      "effect": "Současné užívání SSRI a klopidogrelu může zvýšit riziko krvácení, protože SSRI ovlivňují aktivaci krevních destiček; je zapotřebí zvýšená opatrnost.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cyp2c19_inhibitor",
      "drug_class": "Silné nebo středně silné inhibitory CYP2C19",
      "effect": "Mohou snížit hladinu aktivního metabolitu klopidogrelu. Z preventivních důvodů se současnému podávání vyhněte. Mezi příklady patří omeprazol, esomeprazol, fluvoxamin, fluoxetin, moklobemid, vorikonazol, flukonazol, tiklopidin, karbamazepin a efavirenz. Klinický význam interakce není jasný. Omeprazol snižoval expozici aktivnímu metabolitu; podobnou interakci lze očekávat u esomeprazolu. U pantoprazolu nebo lansoprazolu byl pokles méně výrazný; klopidogrel lze podávat s pantoprazolem.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:10648",
      "drug": "Rifampicin",
      "effect": "Rifampicin silně indukuje CYP2C19, zvyšuje hladinu aktivního metabolitu klopidogrelu a inhibici krevních destiček, což může zejména zvýšit riziko krvácení. Souběžnému užívání se z preventivních důvodů vyhněte.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:10648",
      "drug": "Rosuvastatin",
      "effect": "Klopidogrel zvyšoval expozici rosuvastatinu: po dávce klopidogrelu 300 mg se AUC zvýšila 2krát a Cmax 1,3krát; při opakovaném podávání klopidogrelu 75 mg denně se AUC zvýšila 1,4krát bez vlivu na Cmax.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:10648",
      "drug": "Repaglinid",
      "effect": "Klopidogrel zvyšuje expozici repaglinidu inhibicí CYP2C8 jeho glukuronidovým metabolitem. Kvůli riziku zvýšení plazmatických koncentrací je při současném podávání zapotřebí zvýšená opatrnost.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {

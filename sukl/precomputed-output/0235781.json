  "combinations": [
    {
      "class_id": "group:cyp3a4_inhibitor_strong",
      "drug_class": "Silné inhibitory CYP3A4",
      "effect": "Silné inhibitory CYP3A4 mohou výrazně zvýšit hladinu felodipinu; kombinace se nemá užívat. Při klinicky významných nežádoucích účincích z vyšší expozice může lékař upravit dávku felodipinu nebo přerušit léčbu inhibitorem. Mezi příklady patří itrakonazol, erythromycin a ritonavir; grapefruitová šťáva také může zvýšit hladinu a nesmí se s felodipinem užívat.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inhibitor",
      "drug_class": "Inhibitory CYP3A4",
      "effect": "Inhibitory CYP3A4 mohou zvýšit hladinu felodipinu. Erythromycin zvýšil jeho maximální koncentraci i celkovou expozici přibližně 2,5krát; cimetidin je zvýšil přibližně o 55 %. Silné inhibitory, například itrakonazol, zvyšují expozici výrazně více a jejich kombinace s felodipinem se nemá užívat.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inducer_strong",
      "drug_class": "Silné induktory CYP3A4",
      "effect": "Silné induktory CYP3A4 mohou výrazně snížit hladinu felodipinu; kombinace se nemá užívat. Pokud je účinek felodipinu kvůli nižší expozici nedostatečný, lékař může upravit dávku felodipinu nebo přerušit léčbu induktorem. Příklady zahrnují karbamazepin, fenytoin, rifampicin, fenobarbital a třezalku tečkovanou; u karbamazepinu, fenytoinu nebo fenobarbitalu klesla maximální koncentrace o 82 % a celková expozice o 96 %.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Takrolimus",
      "effect": "Felodipin může zvýšit hladinu takrolimu; při současném užívání má lékař sledovat jeho sérovou koncentraci a podle potřeby upravit dávku.",
      "effect_type": "increased_exposure",
      "side_effects": []
    }
  ],
  "usage": "Používá se k léčbě vysokého krevního tlaku a stabilní anginy pectoris.",

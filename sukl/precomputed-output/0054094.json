        }
      ]
    },
    {
      "drug": "Fluoxetin",
      "effect": "Vzácně byly při současném podávání hlášeny zvýšené plazmatické hladiny trazodonu a nežádoucí účinky. Fluoxetin inhibuje CYP1A2/2D6; mechanismus interakce není zcela objasněn a nelze vyloučit farmakodynamickou interakci v podobě serotoninového syndromu.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "drug": "Karbamazepin",
      "effect": "Snižuje plazmatické koncentrace trazodonu a jeho aktivního metabolitu m-chlorofenylpiperazinu; dávka 400 mg/den snížila jejich koncentrace o 76 % a 60 %. Pacienta je třeba pečlivě sledovat a v případě potřeby zvážit zvýšení dávky trazodonu.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "drug_class": "Perorální kontraceptiva, fenytoin, karbamazepin a barbituráty",
      "effect": "Urychlují metabolismus antidepresiv, což může snížit expozici trazodonu.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "drug": "Fenytoin",
      "effect": "Současné podávání může zvýšit sérové hladiny fenytoinu; při souběžné léčbě je třeba zvážit monitorování jeho sérových hladin. Fenytoin může také urychlovat metabolismus antidepresiv.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "drug": "Cimetidin",
      "effect": "Cimetidin inhibuje metabolismus antidepresiv, a může tak zvýšit expozici trazodonu.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "drug_class": "Některá antipsychotika",
      "effect": "Mohou inhibovat metabolismus antidepresiv. Sedativní účinek antipsychotik může být trazodonem zvýšen; v takových případech se doporučuje snížení dávky. U starších pacientů se může přidávat účinek na ortostatickou hypotenzi, ospalost a další anticholinergní účinky trazodonu.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "drug_class": "Hypnotika, sedativa, anxiolytika a antihistaminika",
      "effect": "Trazodon může zvýšit jejich sedativní účinek; v takových případech se doporučuje snížení dávky. U starších pacientů může souběžné užívání psychotropních přípravků zvýšit riziko ortostatické hypotenze, ospalosti a dalších účinků trazodonu.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "drug_class": "Další serotonergní léčiva, včetně SSRI, SNRI a inhibitorů MAO, a neuroleptika",
      "effect": "Při současném podávání byly popsány interakce typu serotoninového syndromu nebo maligního neuroleptického syndromu. U neuroleptik byly popsány i fatální případy maligního neuroleptického syndromu. Sledujte zejména vysokou tělesnou teplotu, svalové záškuby, zmatenost nebo neklid.",
      "effect_type": "increased_toxicity",

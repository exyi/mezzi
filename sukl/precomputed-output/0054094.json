  "combinations": [
    {
      "drug_class": "Silné inhibitory CYP3A4 (např. erythromycin, ketokonazol, itrakonazol, ritonavir, indinavir a nefazodon)",
      "effect": "Mohou podstatně zvýšit plazmatické koncentrace trazodonu. Při podávání ritonaviru 200 mg dvakrát denně byly hladiny trazodonu zvýšené více než dvojnásobně a objevila se nevolnost, synkopa a hypotenze. Je-li současné podávání nutné, zvažuje se nižší dávka trazodonu; souběžnému podávání se má pokud možno vyhnout.",
      "effect_type": "increased_exposure",
      "side_effects": [
        {

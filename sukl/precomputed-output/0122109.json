  "combinations": [
    {
      "class_id": "atc:C09AA",
      "drug_class": "Inhibitory ACE",
      "effect": "Souběžné užívání s přípravkem Lorista H se obecně nedoporučuje, protože dvojí blokáda systému renin-angiotensin-aldosteron zvyšuje riziko nízkého krevního tlaku, vysoké hladiny draslíku a zhoršení funkce ledvin včetně akutního selhání. Kombinace inhibitoru ACE a blokátoru receptoru angiotensinu II se nesmí používat u pacientů s diabetickou nefropatií. Pokud je dvojí blokáda nezbytná, patří pouze pod dohled specialisty s častým sledováním funkce ledvin, elektrolytů a krevního tlaku.",
      "effect_type": "increased_toxicity",
      "side_effects": [
        {
          "ctcae": "Hypotension",
          "frequency": null,
          "label": "Nízký krevní tlak při dvojí blokádě systému renin-angiotensin-aldosteron.",
          "action": null,
          "action_condition": null

    {
      "ctcae": "Allergic reaction",
      "frequency": "very_rare",
      "label": "Celková alergická reakce, například vyrážka, horečka, bolesti kloubů nebo dýchací potíže; případně celkový zánět tlustého střeva se silným průjmem a bolestmi břicha",
      "action": "discontinue_treatment",
      "action_condition": {

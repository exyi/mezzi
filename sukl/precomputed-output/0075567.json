      "action_condition": null
    },
    {
      "ctcae": "Idiopathic intracranial hypertension",
      "frequency": "not_known",
      "label": "Zvýšený tlak uvnitř lebky (idiopatická intrakraniální hypertenze), který se může projevit silnou nebo opakující se bolestí hlavy, poruchami vidění nebo zvoněním či hučením v uších",
      "action": "contact_doctor",
      "action_condition": {
        "patient_guide": "Pokud máte silnou nebo opakující se bolest hlavy, poruchy vidění nebo zvonění či hučení v uších.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Stevens-Johnson syndrome",
      "frequency": "not_known",
      "label": "Stevensův-Johnsonův syndrom: závažná vyrážka s načervenalými, nevystupujícími skvrnami, často ve tvaru terče nebo kruhu s puchýřkem uprostřed, olupováním kůže a vřídky v ústech, krku, nose, na pohlavních orgánech nebo očích; může ji předcházet horečka a příznaky podobné chřipce a může se přidat zvětšení uzlin. Při prvních známkách závažné kožní reakce vyhledejte okamžitě lékařskou pomoc.",
      "action": "emergency",
      "action_condition": {
        "patient_guide": "Pokud se objeví závažná vyrážka, olupování kůže nebo vřídky na sliznicích, případně horečka s příznaky podobnými chřipce.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Toxic epidermal necrolysis",
      "frequency": "not_known",
      "label": "Toxická epidermální nekrolýza: rozsáhlá závažná vyrážka s olupováním kůže a vřídky na sliznicích. Při prvních známkách závažné kožní reakce vyhledejte okamžitě lékařskou pomoc.",
      "action": "emergency",
      "action_condition": {
        "patient_guide": "Pokud se objeví rozsáhlá závažná vyrážka, olupování kůže nebo vřídky na sliznicích.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Skin and subcutaneous tissue disorders - Other, specify",
      "frequency": "not_known",
      "label": "Poléková reakce s eozinofilií a systémovými příznaky (DRESS), závažná kožní reakce. Při prvních známkách závažné kožní reakce vyhledejte okamžitě lékařskou pomoc.",
      "action": "emergency",
      "action_condition": {
        "patient_guide": "Pokud se objeví závažná kožní vyrážka nebo jiné známky přecitlivělosti.",

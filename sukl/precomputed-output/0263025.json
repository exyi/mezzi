    {
      "class_id": "group:cyp3a4_inhibitor_strong",
      "drug_class": "Silné inhibitory CYP3A4",
      "effect": "Doxazosin je substrátem CYP3A4. Při současném užívání silných inhibitorů CYP3A4, například klarithromycinu, indinaviru, itrakonazolu, ketokonazolu, nefazodonu, nelfinaviru, ritonaviru, sachinaviru, telithromycinu nebo vorikonazolu, je nutná opatrnost; konkrétní změna koncentrace doxazosinu není v textu stanovena.",
      "effect_type": null,
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Léky na poruchy erekce (inhibitory PDE-5)",
      "effect": "Doxazosin společně se sildenafilem, tadalafilem nebo vardenafilem může u některých pacientů způsobit symptomatický pokles krevního tlaku, protože obě léčiva rozšiřují cévy. Léčba inhibitorem PDE-5 se má zahájit až při stabilním stavu na alfa-blokátoru, nejnižší možnou dávkou a s odstupem 6 hodin od doxazosinu. Studie s tabletami s prodlouženým uvolňováním nebyly provedeny.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },

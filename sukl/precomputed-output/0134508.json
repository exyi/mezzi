  "combinations": [
    {
      "class_id": "group:serotonergic",
      "drug_class": "Serotonergní léčivé přípravky, například opioidy a triptany",
      "effect": "Escitalopram s opioidy (včetně tramadolu), triptany (včetně sumatriptanu) nebo tryptofanem může vyvolat serotoninový syndrom; při souběžném užívání je nutná opatrnost. Kombinace s MAO inhibitory, moklobemidem nebo linezolidem je kontraindikována; při případném nezbytném podání linezolidu či moklobemidu SPC popisuje minimální dávku a pečlivé sledování. Po ireverzibilním neselektivním IMAO je nutné před zahájením escitalopramu vyčkat 14 dní a před zahájením IMAO po escitalopramu nejméně 7 dní.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "group:qt_prolonging",
      "drug_class": "Léčivé přípravky prodlužující QT interval",
      "effect": "Současné užívání escitalopramu s léčivými přípravky prodlužujícími QT interval je kontraindikováno, protože se mohou jejich účinky na srdeční rytmus sčítat. Jde mimo jiné o antiarytmika třídy IA a III, některá antipsychotika, tricyklická antidepresiva, některá antimikrobiální léčiva a některá antihistaminika.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "group:cyp2c19_inhibitor",
      "drug_class": "Inhibitory CYP2C19",
      "effect": "Léčiva inhibující CYP2C19 mohou zvýšit hladinu escitalopramu v krvi. U omeprazolu 30 mg denně se zvýšila přibližně o 50 %; u esomeprazolu, flukonazolu, fluvoxaminu, lansoprazolu a tiklopidinu se doporučuje opatrnost a podle nežádoucích účinků může lékař snížit dávku escitalopramu.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Cimetidin",
      "effect": "Cimetidin 400 mg dvakrát denně zvýšil hladinu escitalopramu v krvi přibližně o 70 %. Při souběžném užívání se doporučuje opatrnost a může být nutné upravit dávku escitalopramu.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:serotonergic",
      "drug_class": "Třezalka tečkovaná (Hypericum perforatum)",

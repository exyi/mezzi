  "combinations": [
    {
      "drug_class": "Léčivé přípravky s anticholinergními vlastnostmi",
      "effect": "Současné užívání může zesílit léčebný účinek i nežádoucí účinky obou léčiv. Mezi ukončením léčby přípravkem Urizia a zahájením jiné anticholinergní léčby je nutná přestávka přibližně 1 týden.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "drug_class": "Agonisté cholinergních receptorů (cholinergika)",
      "effect": "Mohou snížit účinnost solifenacinu, a tím i přípravku Urizia.",
      "effect_type": "antagonism",
      "side_effects": []
    },
    {
      "drug_class": "Silné inhibitory CYP3A4 (např. ketokonazol, ritonavir, nelfinavir, itrakonazol)",
      "effect": "Mohou zvýšit expozici solifenacinu i tamsulosinu. Přípravek Urizia používejte v této kombinaci s opatrností; maximální denní dávka je jedna tableta (6 mg/0,4 mg). Přípravek Urizia se nesmí kombinovat se silnými inhibitory CYP3A4 u pacientů se slabým metabolickým fenotypem CYP2D6 nebo u pacientů, kteří současně užívají silné inhibitory CYP2D6, například paroxetin.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "drug_class": "Středně účinné inhibitory CYP3A4 (např. verapamil)",
      "effect": "Mohou zvýšit expozici solifenacinu i tamsulosinu. Přípravek Urizia používejte v této kombinaci s opatrností; maximální denní dávka je jedna tableta (6 mg/0,4 mg).",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "drug": "Cimetidin",
      "effect": "Slabý inhibitor CYP3A4; při současném užívání se zvýšila plocha pod křivkou (AUC) tamsulosinu 1,44krát, zatímco maximální koncentrace (Cmax) se významně nezměnila. Přípravek Urizia lze se slabými inhibitory CYP3A4 užívat.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "drug": "Paroxetin",
      "effect": "Silný inhibitor CYP2D6; při současném užívání 20 mg paroxetinu denně se maximální koncentrace tamsulosinu zvýšila 1,3krát a AUC 1,6krát. Přípravek Urizia lze užívat s inhibitory CYP2D6, nesmí se však kombinovat se silným inhibitorem CYP3A4 u pacienta, který současně užívá silný inhibitor CYP2D6.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "drug_class": "Induktory CYP3A4 (např. rifampicin)",

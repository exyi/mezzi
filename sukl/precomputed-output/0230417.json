  "combinations": [
    {
      "class_id": "group:serotonergic",
      "drug_class": "Léky se serotoninergním účinkem",
      "effect": "Současné užívání může zesílit účinek na serotoninové receptory a vyvolat serotoninový syndrom. Týká se zejména opioidů (včetně tramadolu a buprenorfinu), triptanů (včetně sumatriptanu a oxitriptanu) a tryptofanu; opatrnost je potřebná také u lithia. Kombinace s moklobemidem nebo buspironem byla spojena se serotoninovým syndromem. Současné užívání s agonisty 5-HT, například sumatriptanem a dalšími triptany, se nedoporučuje.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:serotonergic",
      "drug_class": "Inhibitory monoaminooxidázy (IMAO)",
      "effect": "Kombinace může vyvolat závažné nežádoucí účinky včetně serotoninového syndromu. Citalopram se nesmí užívat s IMAO; po vysazení ireverzibilního IMAO se obvykle čeká 14 dní a po vysazení citalopramu 7 dní před zahájením IMAO. U reverzibilních IMAO platí doba uvedená v jejich informaci o přípravku. Selegilin v dávce vyšší než 10 mg denně je kontraindikován. Kombinace s linezolidem je kontraindikována, pokud nelze sledovat a kontrolovat krevní tlak.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "group:qt_prolonging",
      "drug_class": "Léky prodlužující QT interval",
      "effect": "Současné užívání je kontraindikováno, protože nelze vyloučit součet účinku na prodloužení QT intervalu a riziko závažné poruchy srdečního rytmu. Patří sem antiarytmika třídy IA a III, antipsychotika (například fenothiaziny, pimozid a haloperidol), tricyklická antidepresiva, některá antibiotika (například sparfloxacin, moxifloxacin, nitrožilní erythromycin a pentamidin), antimalarika (zejména halofantrin) a antihistaminika astemizol a mizolastin.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Léky zvyšující riziko krvácení nebo ovlivňující funkci krevních destiček",
      "effect": "Citalopram může spolu s antikoagulancii, léky ovlivňujícími destičky nebo jinými přípravky zvyšujícími riziko krvácení zvýšit sklon ke krvácení; je nutná opatrnost. Zahrnuje kyselinu acetylsalicylovou, nesteroidní protizánětlivé léky, dipyridamol, tiklopidin a některá antipsychotika.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Léky snižující hladinu draslíku nebo hořčíku v krvi",
      "effect": "Současné užívání může při nízké hladině draslíku nebo hořčíku zvýšit riziko závažné srdeční arytmie; doporučuje se opatrnost.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Léky snižující práh pro vznik záchvatů",
      "effect": "Citalopram může snižovat práh pro vznik záchvatů; při současném užívání dalších léků s tímto účinkem je doporučena opatrnost. Patří sem některá antidepresiva, neuroleptika, meflochin, bupropion a tramadol.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:A02BA01",
      "drug_class": "Cimetidin",
      "effect": "Cimetidin mírně zvyšuje hladinu citalopramu v ustáleném stavu. Při současném užívání se doporučuje opatrnost.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:A02BC01",
      "drug_class": "Omeprazol a další inhibitory CYP2C19",
      "effect": "Inhibitory CYP2C19, například omeprazol, esomeprazol, flukonazol, fluvoxamin, lansoprazol a tiklopidin, mohou zvýšit hladinu citalopramu. Při současném užívání se doporučuje opatrnost; podle nežádoucích účinků může lékař snížit dávku citalopramu. Zvýšení koncentrace přibližně o 50 % bylo zjištěno u escitalopramu, aktivního stereoizomeru citalopramu, s omeprazolem, nikoli u přípravku Citalec.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:C07AB02",
      "drug_class": "Metoprolol",
      "effect": "Citalopram může zvýšit hladinu metoprololu v krvi přibližně na dvojnásobek. Nebylo zjištěno významné zesílení vlivu metoprololu na krevní tlak nebo srdeční frekvenci; při užívání s metoprololem, zejména při léčbě srdečního selhání, se doporučuje opatrnost a může být třeba upravit dávku.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:N06AA01",
      "drug_class": "Desipramin",
      "effect": "Citalopram může zvýšit hladinu desipraminu v krvi; může být nutné snížit dávku desipraminu.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:N06AA02",
      "drug_class": "Imipramin",
      "effect": "Při současném užívání se zvýšila hladina desipraminu, hlavního metabolitu imipraminu; hladiny citalopramu ani imipraminu se významně nezměnily.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {

    },
    {
      "class_id": "group:cyp3a4_inhibitor",
      "drug_class": "Inhibitory CYP3A4, například makrolidová antibiotika, azolová antimykotika, inhibitory proteáz, cimetidin a grapefruitová šťáva",
      "effect": "Snížením odbourávání oxykodonu mohou inhibitory CYP3A4 zvýšit jeho koncentraci v plazmě. U itrakonazolu 200 mg perorálně po dobu 5 dnů byla AUC perorálního oxykodonu průměrně 2,4krát vyšší (rozmezí 1,5–3,4); u vorikonazolu 200 mg dvakrát denně po dobu 4 dnů (400 mg v prvních dvou dávkách) 3,6krát vyšší (2,7–5,6); u telithromycinu 800 mg perorálně po dobu 4 dnů 1,8krát vyšší (1,3–2,3); a u grapefruitové šťávy 200 ml třikrát denně po dobu 5 dnů 1,7krát vyšší (1,1–2,1). Může být nutné upravit dávku oxykodonu.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inducer",
      "drug_class": "Induktory CYP3A4, například rifampicin, karbamazepin, fenytoin a třezalka tečkovaná",
      "effect": "Indukcí metabolismu mohou zvýšit odbourávání oxykodonu a snížit jeho koncentraci v plazmě. Třezalka tečkovaná 300 mg třikrát denně po dobu 15 dnů snížila AUC perorálního oxykodonu průměrně přibližně o 50 % (rozmezí 37–57 %); rifampicin 600 mg jednou denně po dobu 7 dnů ji snížil průměrně přibližně o 86 %. Může být nutné upravit dávku oxykodonu.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },

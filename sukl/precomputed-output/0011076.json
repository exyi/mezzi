    {
      "class_id": null,
      "drug_class": "Anticholinergika a léky s anticholinergní aktivitou, například tricyklická antidepresiva, antihistaminika, antipsychotika, myorelaxancia a antiparkinsonika",
      "effect": "Současné podávání s oxykodonem může zvýšit anticholinergní nežádoucí účinky.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Inhibitory monoaminooxidázy (IMAO)",
      "effect": "Současné užívání s oxykodonem může tlumit některé oblasti centrální nervové soustavy a způsobit závažné poruchy krevního tlaku; může také vést k excitaci nebo depresi centrální nervové soustavy a hypertenzní či hypotenzní krizi. Oxykodon se má používat opatrně při léčbě IMAO nebo do 14 dnů od jejich vysazení. Příbalová informace současně uvádí, že přípravek nemáte užívat, pokud užíváte IMAO nebo jste je užíval(a) v posledních dvou týdnech a neinformoval(a) jste o tom lékaře.",
      "effect_type": "increased_toxicity",

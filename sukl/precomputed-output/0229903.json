  "combinations": [
    {
      "class_id": "atc:C09CA",
      "drug_class": "Blokátory receptoru pro angiotensin II (sartany)",
      "effect": "Současné užívání s perindoprilem může zvýšit riziko nízkého krevního tlaku, vysoké hladiny draslíku a zhoršení funkce ledvin včetně akutního selhání ledvin. Kombinace se obecně nedoporučuje; u pacientů s diabetickou nefropatií se nesmí užívat společně. Pokud je ve výjimečném případě nezbytná, léčbu vede specialista a pečlivě sleduje funkci ledvin, draslík a krevní tlak.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Aliskiren",
      "effect": "Současné užívání s perindoprilem je kontraindikováno u pacientů s diabetem nebo poruchou funkce ledvin (GFR pod 60 ml/min/1,73 m²). U ostatních pacientů se kombinace nedoporučuje, protože může zvýšit hladinu draslíku, zhoršit funkci ledvin a zvýšit riziko srdečně-cévních komplikací. Při případném současném podání lékař sleduje funkci ledvin, draslík a krevní tlak.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "atc:C03D",
      "drug_class": "Draslík šetřící diuretika",
      "effect": "Současné užívání s perindoprilem může výrazně zvýšit hladinu draslíku v krvi. Kombinace se obecně nedoporučuje; u pacientů se srdečním selháním NYHA II–IV, ejekční frakcí pod 40 % a předchozí léčbou inhibitorem ACE a kličkovým diuretikem hrozí potenciálně smrtelná hyperkalemie, zvláště při nedodržení dávkování. Pokud lékař kombinaci zvolí, sleduje draslík a funkci ledvin.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:A12BA",
      "drug_class": "Doplňky draslíku a náhražky soli s draslíkem",
      "effect": "Mohou při současném užívání s perindoprilem významně zvýšit hladinu draslíku v krvi. Kombinace se obecně nedoporučuje; pokud je nutná, lékař ji vede opatrně a pravidelně kontroluje hladinu draslíku.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:J01EA01",
      "drug_class": "Trimethoprim",
      "effect": "Současné užívání s perindoprilem může zvýšit hladinu draslíku v krvi. Opatrnost je nutná zejména při současném užívání kotrimoxazolu; lékař pravidelně kontroluje draslík.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },

  "combinations": [
    {
      "class_id": "group:cns_depressant",
      "drug_class": "Léky tlumící centrální nervovou soustavu, včetně benzodiazepinů, dalších opioidů, gabapentinoidů, anxiolytik, hypnotik, sedativ, antipsychotik, antidepresiv, fenothiazinů a alkoholu",
      "effect": "Současné užívání s oxykodonem zesiluje tlumivý účinek na centrální nervovou soustavu a zvyšuje riziko sedace, útlumu dýchání, kómatu a úmrtí. Kombinace je určena jen tehdy, není-li možná jiná léčba; lékař má omezit dávku a dobu současného užívání a zvolit nejnižší účinnou dávku na co nejkratší dobu. Pacient a pečující osoby mají sledovat příznaky útlumu dýchání a sedace.",
      "effect_type": "increased_toxicity",
      "side_effects": [

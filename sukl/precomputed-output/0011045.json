    {
      "drug_class": "Inhibitory monoaminooxidázy (IMAO)",
      "effect": "IMAO mohou v interakci s opioidními analgetiky vyvolat excitaci nebo útlum centrální nervové soustavy a hypertenzní či hypotenzní krizi. Oxykodon se má užívat opatrně u pacientů užívajících IMAO nebo během 14 dnů po jejich vysazení; pokud jste užíval(a) IMAO nyní nebo v posledních dvou týdnech, neužívejte OxyContin, dokud o tom neinformujete lékaře.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "drug_class": "Léky ovlivňující serotonin, zejména SSRI a SNRI",
      "effect": "Současné podávání může způsobit serotoninovou toxicitu. Oxykodon se má u těchto pacientů užívat opatrně a může být nutné snížit jeho dávku. Příznaky mohou zahrnovat změny psychického stavu, nestabilitu autonomního nervového systému, neuromuskulární abnormality a/nebo zažívací příznaky.",
      "effect_type": "increased_toxicity",
      "side_effects": [
        {
          "ctcae": null,
          "frequency": null,
          "label": "Serotoninová toxicita: změny psychického stavu (například agitovanost, halucinace, kóma), nestabilita autonomního nervového systému (například zrychlený tep, kolísání krevního tlaku, zvýšená tělesná teplota), nervosvalové abnormality (například zvýšené reflexy, porucha koordinace, ztuhlost) a/nebo nevolnost, zvracení či průjem.",
          "action": "contact_doctor",
          "action_condition": {
            "patient_guide": "Pokud se u vás objeví příznaky serotoninové toxicity, například mimovolní rytmické stahy svalů, neklid s potřebou pohybu, nadměrné pocení, třes, zvýšené reflexy, zvýšené svalové napětí nebo tělesná teplota nad 38 °C."
          }
        }
      ]
    },
    {
      "drug_class": "Inhibitory CYP3A4, včetně některých makrolidových antibiotik, azolových antimykotik, inhibitorů proteáz a cimetidinu",
      "effect": "Inhibice CYP3A4 může snížit odbourávání a clearance oxykodonu a zvýšit jeho plazmatické koncentrace; může být nutná úprava dávky. Itrakonazol 200 mg perorálně po dobu pěti dnů zvýšil AUC oxykodonu v průměru přibližně 2,4krát (rozmezí 1,5–3,4); vorikonazol 200 mg dvakrát denně po dobu čtyř dnů (400 mg v prvních dvou dávkách) přibližně 3,6krát (2,7–5,6); telithromycin 800 mg denně po dobu čtyř dnů přibližně 1,8krát (1,3–2,3).",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "drug": "Grapefruitová šťáva",
      "effect": "Grapefruitová šťáva inhibuje CYP3A4 a může snížit clearance oxykodonu a zvýšit jeho plazmatické koncentrace. Po 200 ml třikrát denně po dobu pěti dnů byla AUC oxykodonu v průměru přibližně 1,7krát vyšší (rozmezí 1,1–2,1). Během užívání OxyContinu se grapefruitová šťáva nemá pít.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "drug_class": "Induktory CYP3A4, například rifampicin, karbamazepin, fenytoin a třezalka tečkovaná",
      "effect": "Indukce CYP3A4 může urychlit metabolismus a zvýšit clearance oxykodonu, snížit jeho plazmatické koncentrace a oslabit jeho účinek; může být nutná úprava dávky. Třezalka tečkovaná 300 mg třikrát denně po dobu patnácti dnů snížila AUC v průměru přibližně o 50 % (rozmezí 37–57 %) a rifampicin 600 mg jednou denně po dobu sedmi dnů přibližně o 86 %.",

  "combinations": [
    {
      "drug_class": "Jiná nesteroidní protizánětlivá léčiva (NSAID), včetně selektivních inhibitorů COX-2 a kyseliny acetylsalicylové v protizánětlivých dávkách",
      "effect": "Současnému užívání Nimesilu s jinými NSAID, včetně selektivních inhibitorů COX-2, je nutné se vyhnout; současné podávání se nedoporučuje. Totéž platí pro kyselinu acetylsalicylovou v protizánětlivých dávkách (jednorázová dávka ≥ 1 g nebo celková denní dávka ≥ 3 g). Pacienti mají být poučeni, aby současně neužívali další analgetika.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },

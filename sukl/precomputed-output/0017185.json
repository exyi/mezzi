    {
      "drug_class": "ACE inhibitory nebo antagonisté angiotenzinu II",
      "effect": "NSAID mohou snížit účinnost antihypertenziv. U některých pacientů se sníženou funkcí ledvin, například při dehydrataci nebo ve vyšším věku s poruchou funkce ledvin, může současné užívání ACE inhibitorů či antagonistů angiotenzinu II a inhibitorů cyklooxygenázy zhoršit funkci ledvin, případně vyvolat akutní poruchu funkce ledvin, která bývá obvykle vratná. Kombinaci je třeba zvážit, zejména u těchto pacientů; doporučuje se dostatečná hydratace a zvážení sledování funkce ledvin po zahájení léčby a poté pravidelně.",
      "effect_type": "increased_toxicity",
      "side_effects": [
        {
          "ctcae": "Acute kidney injury",
          "frequency": null,
          "label": "Možné akutní zhoršení funkce ledvin",
          "action": null,
          "action_condition": null
        }
      ]
    },
    {
      "drug": "Furosemid",
      "effect": "Nimesulid přechodně snižuje u zdravých osob účinek furosemidu na vylučování sodíku a v menší míře draslíku a snižuje odpověď na diuretikum. Současné podávání snižuje AUC furosemidu přibližně o 20 % a jeho kumulativní vylučování, ale nemění renální clearance. U pacientů náchylných k poruše ledvin a u kardiaků je nutná opatrnost.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "drug": "Lithium",
      "effect": "NSAID mohou snížit clearance lithia, zvýšit jeho hladinu v plazmě a vést k projevům toxicity. Při předepsání Nimesilu pacientovi léčenému lithiem je třeba pečlivě sledovat hladinu lithia v plazmě.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "drug": "Léčivé přípravky metabolizované CYP2C9",
      "effect": "Nimesulid inhibuje CYP2C9, takže při současném užívání může dojít ke zvýšení plazmatických koncentrací léčiv metabolizovaných tímto enzymem.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "drug": "Methotrexát",
      "effect": "Opatrnost je nutná, pokud je nimesulid užit v intervalu kratším než 24 hodin před léčbou methotrexatem nebo po ní, protože může dojít ke zvýšení koncentrace methotrexatu v séru a tím k jeho zvýšené toxicitě.",
      "effect_type": "increased_toxicity",
      "side_effects": []

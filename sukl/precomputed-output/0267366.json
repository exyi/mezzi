      "class_id": "atc:A10BG",
      "drug_class": "Glitazony (thiazolidindiony)",
      "effect": "Při současném užívání fenofibrátu a glitazonu byly hlášeny případy vratného paradoxního poklesu HDL cholesterolu. Lékař má hladinu HDL sledovat; při příliš nízké hodnotě se doporučuje ukončit léčbu jedním z těchto přípravků.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },

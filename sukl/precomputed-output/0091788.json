  "combinations": [
    {
      "class_id": "group:cns_depressant",
      "drug_class": "Látky tlumící centrální nervový systém, včetně antipsychotik, hypnotik, sedativ, antidepresiv, opioidních analgetik, antiepileptik, anestetik, sedativních antihistaminik, alkoholu a dalších látek s účinkem na CNS",
      "effect": "Současné užívání s alprazolamem může zesílit útlum centrálního nervového systému. U opioidů se zvyšuje riziko ospalosti, útlumu dýchání, kómatu a úmrtí; tato kombinace je určena jen tehdy, když není možná jiná léčba, a lékař má omezit dávku i dobu společného užívání. Během léčby nepijte alkohol ani bez porady s lékařem neužívejte jiné tlumivé léky.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inhibitor",
      "drug_class": "Léky tlumící enzym CYP3A4",
      "effect": "Mohou zvýšit koncentraci alprazolamu a zesílit jeho účinek. Společné užívání s azolovými antimykotiky, například ketokonazolem nebo itrakonazolem, se nedoporučuje. U nefazodonu, fluvoxaminu a cimetidinu se doporučuje opatrnost a případné snížení dávky; u fluoxetinu, propoxyfenu, perorální antikoncepce, diltiazemu a makrolidových antibiotik je nutná opatrnost.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:588",
      "drug": "Digoxin",
      "effect": "Při současném užívání s alprazolamem byly hlášeny zvýšené koncentrace digoxinu, zvláště u pacientů starších 65 let; lékař má sledovat možné příznaky toxicity digoxinu.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inducer",
      "drug_class": "Léky indukující CYP3A4",
      "effect": "Mohou zvýšit metabolismus alprazolamu.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:588",
      "drug": "Ritonavir",
      "effect": "Interakce s alprazolamem závisí na délce užívání. Krátkodobé užívání nízkých dávek ritonaviru může snížit odbourávání alprazolamu, prodloužit jeho poločas a zesílit jeho účinek; při delším užívání se tento účinek může změnit vlivem indukce CYP3A. Lékař může upravit dávku nebo léčbu alprazolamem ukončit.",
      "effect_type": "changed_exposure",
      "side_effects": []
    }
  ],
  "usage": "Neurol krátkodobě tlumí závažné příznaky úzkosti u dospělých.",

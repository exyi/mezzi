  "combinations": [
    {
      "class_id": "atc:B01",
      "drug_class": "Léky snižující srážlivost krve, včetně antiagregancií a antikoagulancií",
      "effect": "Při současném užívání přípravku Piascledine s antiagregancii nebo antikoagulancii může být zvýšené riziko krvácení. Přípravek má být podáván s opatrností; pacient se má před zahájením užívání poradit s lékařem.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    }
  ],

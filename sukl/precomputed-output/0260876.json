    {
      "ctcae": "Thrombocytopenia",
      "frequency": "rare",
      "label": "Snížený počet krevních destiček (trombocytopenie). Při známkách poruchy srážlivosti, jako jsou červené či purpurové skvrny na kůži, samovolné modřiny nebo krvácení ze sliznic, léčbu přerušte a ihned kontaktujte lékaře.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Pokud se objeví červené nebo purpurové skvrny na kůži, samovolné modřiny nebo krvácení ze sliznic.",
        "min_severity": 2
      }
    },
    {
      "ctcae": "Hypertension",
      "frequency": "rare",
      "label": "Zvýšený krevní tlak; mohou se objevit bolest hlavy, poruchy sluchu nebo návaly horka.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Allergic reaction",
      "frequency": "uncommon",
      "label": "Alergická reakce nebo přecitlivělost: svědění, kopřivka, zarudnutí či vyrážka, otok obličeje nebo potíže s dýcháním. Při prvním výskytu kožní reakce nebo příznaků přecitlivělosti léčbu ukončete a poraďte se s lékařem; příbalová informace navíc uvádí okamžitý kontakt s lékařem.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Při prvním výskytu kožní reakce nebo příznaků přecitlivělosti, například otoku obličeje či potíží s dýcháním.",
        "min_severity": 1
      }
    },
    {
      "ctcae": "Skin and subcutaneous tissue disorders - Other, specify",
      "frequency": "rare",
      "label": "Silná kožní vyrážka. Přestaňte lék užívat a ihned to sdělte lékaři; může být potřebná naléhavá lékařská péče.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Pokud je vyrážka silná.",
        "min_severity": 2
      }
    },
    {
      "ctcae": "Hepatobiliary disorders - Other, specify",
      "frequency": "uncommon",
      "label": "Poruchy jater nebo žlučových cest: poškození jater, obstrukce žlučových cest, jaterní cytolýza nebo cholestáza. Mohou se projevit žloutenkou, bolestí břicha s pocitem na zvracení, změnou barvy stolice či tmavou močí; byly hlášeny také zvýšené hodnoty jaterních enzymů, alkalické fosfatázy a bilirubinu. Při známkách poruchy přerušte léčbu a ihned kontaktujte lékaře.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Pokud se objeví žloutnutí kůže nebo očí, nevysvětlitelný pocit na zvracení, zvracení, bolest břicha, únava, ztráta chuti k jídlu nebo tmavá moč.",
        "min_severity": 2
      }
    },
    {
      "ctcae": "Alanine aminotransferase increased",
      "frequency": "uncommon",
      "label": "Zvýšená hladina aminotransferáz; hlášeno po uvedení přípravku na trh jako součást jaterních poruch.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Alkaline phosphatase increased",
      "frequency": "uncommon",
      "label": "Zvýšená hladina alkalické fosfatázy; hlášena po uvedení přípravku na trh jako součást jaterních poruch.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Blood bilirubin increased",
      "frequency": "uncommon",
      "label": "Zvýšená hladina bilirubinu; hlášena po uvedení přípravku na trh jako součást jaterních poruch.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "GGT increased",
      "frequency": "uncommon",

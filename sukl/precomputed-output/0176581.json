  "combinations": [
    {
      "class_id": "group:cyp3a4_inhibitor_strong",
      "drug_class": "Silné inhibitory CYP3A4",
      "effect": "Lerkanidipin se metabolizuje enzymem CYP3A4. Při současném užívání silných inhibitorů CYP3A4, například ketokonazolu, itrakonazolu, ritonaviru, erythromycinu, troleandomycinu nebo klarithromycinu, se může výrazně zvýšit jeho hladina v krvi a účinek; souběžné podávání je kontraindikováno.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "substance:16263",
      "drug": "Cyklosporin",
      "effect": "Při současném podávání se zvyšuje hladina lerkanidipinu i cyklosporinu v krvi. Léky se nesmějí užívat současně.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Grapefruit nebo grapefruitová šťáva",
      "effect": "Mohou zvýšit dostupnost lerkanidipinu v těle a jeho účinek na snížení krevního tlaku. Lerkanidipin se nesmí užívat současně s grapefruitem ani grapefruitovou šťávou.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inducer",
      "drug_class": "Induktory CYP3A4, včetně některých antiepileptik",
      "effect": "Léky indukující CYP3A4, například fenytoin, fenobarbital, karbamazepin a rifampicin, mohou snížit hladinu lerkanidipinu v krvi a jeho účinek na krevní tlak. Souběžné podávání se nedoporučuje; pokud k němu dojde, lékař má častěji kontrolovat krevní tlak.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:C07A",
      "drug_class": "Beta-blokátory",
      "effect": "Metoprolol snížil biologickou dostupnost lerkanidipinu o 50 %, zatímco jeho vlastní dostupnost zůstala nezměněna. Podobný účinek se může týkat i jiných beta-blokátorů; lékař může upravit dávku lerkanidipinu.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:16263",
      "drug": "Midazolam",
      "effect": "Při současném užití lerkanidipinu 20 mg a midazolamu užívaného ústy u starších dobrovolníků se vstřebávání lerkanidipinu zvýšilo přibližně o 40 % a jeho dosažení trvalo déle. Hladina midazolamu se nezměnila.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:C01AA05",
      "drug": "Digoxin",
      "effect": "U pacientů dlouhodobě léčených digoxinem zvýšil lerkanidipin 20 mg jeho maximální koncentraci v krvi v průměru o 33 %, zatímco celková expozice a vylučování ledvinami se významně nezměnily. Lékař má sledovat známky toxicity digoxinu.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:A02BA01",
      "drug": "Cimetidin",
      "effect": "Cimetidin v dávce 800 mg denně významně nemění hladinu lerkanidipinu. Při vyšší dávce může zvýšit jeho biologickou dostupnost a účinek na snížení krevního tlaku; je třeba postupovat opatrně.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:C10AA01",
      "drug": "Simvastatin",
      "effect": "Při současném užívání se zvýšila celková expozice simvastatinu o 56 % a jeho aktivního metabolitu o 28 %. Při užití lerkanidipinu ráno a simvastatinu večer, jak se doporučuje, se interakce neočekává.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:C07A",
      "drug_class": "Beta-blokátory",
      "effect": "Při současném podávání s metoprololem může být nutné upravit dávku lerkanidipinu. Lékař rozhodne podle účinku léčby.",

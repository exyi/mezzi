  "combinations": [
    {
      "class_id": "substance:13774",
      "drug": "TELMISARTAN",
      "effect": "Současné užívání telmisartanu s přípravky ovlivňujícími systém renin-angiotenzin-aldosteron, jako jsou inhibitory ACE, jiné blokátory receptoru angiotenzinu II nebo aliskiren, může zvýšit riziko nízkého krevního tlaku, vysoké hladiny draslíku a zhoršení funkce ledvin včetně akutního selhání. Kombinace se nedoporučuje; je-li nezbytná, vyžaduje odborný dohled a pečlivé sledování. U diabetické nefropatie se inhibitory ACE a blokátory receptoru angiotenzinu II nesmějí užívat současně. Aliskiren je kontraindikován při diabetu nebo poruše funkce ledvin s GFR pod 60 ml/min/1,73 m².",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:13774",
      "drug": "TELMISARTAN",
      "effect": "Telmisartan může zvýšit hladinu draslíku v krvi. Riziko se zvyšuje při souběžném užívání přípravků s draslíkem, náhražek soli s draslíkem a léků, které mohou hladinu draslíku zvýšit, včetně kalium šetřících diuretik. Pokud se tato kombinace použije kvůli prokázané nízké hladině draslíku, je nutná opatrnost a časté kontroly draslíku.",
      "effect_type": "increased_toxicity",

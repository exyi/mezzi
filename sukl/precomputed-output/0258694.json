      "frequency": "very_rare",
      "label": "Kožní vyrážka včetně zarudnutí, svědění nebo kopřivky.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Dehydration",
      "frequency": null,
      "label": "Dehydratace; riziko při zvracení, průjmu, horečce, pobytu ve vysoké teplotě nebo při menším příjmu tekutin než obvykle. Při těchto příznacích léčbu na krátkou dobu přerušte a další postup konzultujte s lékařem.",
      "action": "discontinue_treatment",
      "action_condition": {

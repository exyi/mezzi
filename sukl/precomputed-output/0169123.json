  "combinations": [
    {
      "class_id": "group:hyperkalemia_risk",
      "drug_class": "Léky zvyšující hladinu draslíku, doplňky draslíku, náhražky soli s draslíkem a draslík šetřící diuretika",
      "effect": "Při současném užívání s losartanem mohou zvýšit hladinu draslíku v krvi. Kombinace se nedoporučuje; mezi příklady patří amilorid, triamteren, spironolakton, heparin a přípravky obsahující trimethoprim.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:C09AA",
      "drug_class": "Inhibitory ACE",
      "effect": "Současné užívání s losartanem se nedoporučuje, protože zvyšuje riziko nízkého krevního tlaku, vysoké hladiny draslíku a zhoršení funkce ledvin včetně akutního selhání. U pacientů s diabetickou nefropatií se inhibitory ACE a blokátory receptorů pro angiotensin II nesmějí užívat současně. Pokud je dvojí blokáda výjimečně nezbytná, probíhá pouze pod dohledem specialisty a s častým sledováním krevního tlaku, funkce ledvin a elektrolytů.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:C09XA02",
      "drug_class": "Aliskiren",
      "effect": "Při současném užívání s losartanem je kombinace kontraindikována u pacientů s diabetem nebo poruchou funkce ledvin (GFR < 60 ml/min/1,73 m²). Dvojí blokáda systému renin-angiotensin-aldosteron zvyšuje riziko nízkého krevního tlaku, vysoké hladiny draslíku a zhoršení funkce ledvin.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "atc:M01A",
      "drug_class": "Nesteroidní protizánětlivé léky včetně inhibitorů COX-2 a kyseliny acetylsalicylové v protizánětlivých dávkách",
      "effect": "Mohou oslabit účinek losartanu na snížení krevního tlaku. Společné užívání s losartanem nebo diuretiky může zvýšit riziko zhoršení funkce ledvin včetně akutního selhání a zvýšení draslíku v krvi, zejména při již narušené funkci ledvin a u starších pacientů. Lékař může zvážit kontrolu funkce ledvin po zahájení a pravidelně během léčby.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Léky snižující krevní tlak a další látky, které mohou jako nežádoucí účinek snižovat krevní tlak",
      "effect": "Mohou zesílit účinek losartanu na snížení krevního tlaku. Mezi uvedené příklady patří tricyklická antidepresiva, antipsychotika, baklofen a amifostin.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:14167",
      "drug": "Lithium",
      "effect": "Současné užívání s losartanem může zvýšit koncentraci lithia v krvi a jeho toxicitu. Kombinace se má používat opatrně a pouze při pečlivém dohledu lékaře; doporučuje se sledovat hladinu lithia v krvi.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:14167",
      "drug": "Flukonazol",

  "combinations": [
    {
      "class_id": "group:qt_prolonging",
      "drug_class": "Léky prodlužující QT interval",
      "effect": "Bikalutamid může jako součást androgen-deprivační léčby prodlužovat QT interval. Při současném užívání léků, které prodlužují QT interval nebo mohou vyvolat torsade de pointes, má lékař pečlivě zvážit přínosy a rizika kombinace.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Léky metabolizované především CYP3A4",
      "effect": "Bikalutamid inhibuje CYP3A4, a může proto zvýšit koncentraci těchto léků; opatrnost je zvlášť potřebná u léků s úzkým terapeutickým rozmezím. U cyklosporinu nebo blokátorů kalciových kanálů může lékař zvážit snížení dávky; u cyklosporinu se při zahájení či ukončení bikalutamidu doporučuje sledovat koncentraci v krvi a klinický stav.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:L04AD01",
      "drug_class": "Cyklosporin",
      "effect": "Bikalutamid inhibuje CYP3A4 a může zvýšit koncentraci cyklosporinu. Při zahájení nebo ukončení léčby bikalutamidem se doporučuje sledovat koncentraci cyklosporinu v krvi a klinický stav; při známkách zvýšeného účinku či nežádoucích účinků může lékař zvážit snížení jeho dávky.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Blokátory kalciových kanálů",
      "effect": "Bikalutamid inhibuje CYP3A4 a může zvýšit koncentraci blokátorů kalciových kanálů. Při známkách zvýšeného účinku či nežádoucích účinků může lékař zvážit snížení jejich dávky.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:13723",
      "drug": "Warfarin",
      "effect": "Bikalutamid může vytěsňovat warfarin z vazby na bílkoviny a zvýšit jeho účinek, protrombinový čas a INR, a tím i riziko krvácení. Při současném užívání lékař pečlivě sleduje PT/INR a může zvážit úpravu dávky warfarinu.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Kumarinová antikoagulancia",
      "effect": "Bikalutamid může zvýšit účinek kumarinových antikoagulancií, protrombinový čas a INR, a tím i riziko krvácení. Při nasazení bikalutamidu lékař pečlivě sleduje PT/INR a může zvážit úpravu dávky antikoagulancia.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:13723",
      "drug": "Cimetidin",
      "effect": "Cimetidin může inhibicí oxidačních pochodů v játrech teoreticky zvýšit plazmatickou koncentraci bikalutamidu a jeho nežádoucí účinky; tato možnost je popsána jako teoretická.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:13723",
      "drug": "Ketokonazol",
      "effect": "Ketokonazol může inhibicí oxidačních pochodů v játrech teoreticky zvýšit plazmatickou koncentraci bikalutamidu a jeho nežádoucí účinky; tato možnost je popsána jako teoretická.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:A03FA02",
      "drug": "Cisaprid",
      "effect": "Současné užívání bikalutamidu a cisapridu je kontraindikováno.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "atc:R06AX12",

      "effect": "Současné užívání bikalutamidu a terfenadinu je kontraindikováno.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "atc:R06AX11",
      "drug": "Astemizol",
      "effect": "Současné užívání bikalutamidu a astemizolu je kontraindikováno.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Léky vyvolávající torsade de pointes",
      "effect": "Při současném užívání bikalutamidu s léky, které mohou vyvolat torsade de pointes, včetně antiarytmik tříd IA a III, methadonu, moxifloxacinu a antipsychotik, má lékař pečlivě zvážit léčbu; u této kombinace je uvedeno riziko prodloužení QT intervalu.",
      "effect_type": "increased_toxicity",
      "side_effects": []

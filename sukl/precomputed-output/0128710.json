  "combinations": [
    {
      "class_id": null,
      "drug": "Rifampicin",
      "effect": "Rifampicin urychluje metabolismus nitrendipinu, takže může snížit jeho účinnost. Současné užívání je kontraindikováno.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inhibitor",
      "drug_class": "Léky, které inhibují CYP3A4",
      "effect": "Mohou zvýšit koncentraci nitrendipinu a jeho účinek. Při současném užívání má lékař sledovat krevní tlak a případně zvážit snížení dávky nitrendipinu. Patří sem například makrolidová antibiotika (ne azithromycin), inhibitory HIV proteázy, azolová antimykotika užívaná ústy, nefazodon, fluoxetin, kvinupristin/dalfopristin, kyselina valproová, cimetidin a ranitidin. U některých kombinací studie nebyly provedeny nebo jsou údaje odvozené od příbuzných léčiv; zvýšení koncentrace proto nelze vyloučit.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug": "Fenytoin",
      "effect": "Fenytoin může jako induktor CYP3A4 výrazně snížit biologickou dostupnost a účinnost nitrendipinu. Pokud lékař zvýší dávku nitrendipinu při současném užívání, po vysazení fenytoinu má zvážit její snížení.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug": "Fenobarbital",
      "effect": "Fenobarbital může jako induktor CYP3A4 výrazně snížit biologickou dostupnost a účinnost nitrendipinu. Pokud lékař zvýší dávku nitrendipinu při současném užívání, po vysazení fenobarbitalu má zvážit její snížení.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug": "Karbamazepin",
      "effect": "Karbamazepin může jako induktor CYP3A4 výrazně snížit biologickou dostupnost a účinnost nitrendipinu. Pokud lékař zvýší dávku nitrendipinu při současném užívání, po vysazení karbamazepinu má zvážit její snížení.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug": "Grapefruitová šťáva",
      "effect": "Grapefruitová šťáva inhibuje CYP3A4 a může zvýšit koncentraci nitrendipinu i jeho účinek; účinek může přetrvávat nejméně tři dny od poslední konzumace. Během užívání nitrendipinu se vyhněte grapefruitům a grapefruitové šťávě.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:C02",
      "drug_class": "Léky snižující krevní tlak",
      "effect": "Nitrendipin může zesílit jejich účinek na snížení krevního tlaku. Příklady zahrnují diuretika, beta-blokátory, ACE inhibitory, antagonisty receptorů AT1, jiné blokátory kalciových kanálů, alfa-blokátory, inhibitory PDE5 a methyldopu.",
      "effect_type": "increased_toxicity",
      "side_effects": []

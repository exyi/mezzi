  "combinations": [
    {
      "class_id": "atc:M01A",
      "drug_class": "Nesteroidní protizánětlivé léky (NSAID)",
      "effect": "Současné užívání Aulinu s jinými NSAID, včetně selektivních inhibitorů COX-2, se nedoporučuje; u kyseliny acetylsalicylové se to týká protizánětlivých dávek (alespoň 1 g v jedné dávce nebo alespoň 3 g denně). Zvyšuje se riziko nežádoucích účinků. Pacienti se mají vyhnout také současnému užívání jiných analgetik.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Kortikosteroidy",
      "effect": "Současné užívání s Aulinem zvyšuje riziko žaludečních a střevních vředů a krvácení.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Antikoagulancia a léky bránící shlukování krevních destiček",
      "effect": "Aulin může zesílit účinek antikoagulancií, například warfarinu; při současném užívání warfarinu nebo podobných antikoagulancií roste riziko krvácivých komplikací. Kombinace se nedoporučuje; pokud se jí nelze vyhnout, lékař pečlivě sleduje srážlivost krve. Antiagregační léky, například kyselina acetylsalicylová, zvyšují riziko krvácení do trávicího traktu.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Selektivní inhibitory zpětného vychytávání serotoninu",
      "effect": "Současné užívání s Aulinem zvyšuje riziko krvácení do trávicího traktu.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Diuretika",
      "effect": "Aulin může snížit účinnost diuretik. U furosemidu přechodně zeslabuje účinek na vylučování sodíku a v menší míře draslíku; snižuje také jeho AUC přibližně o 20 % a kumulativní vylučování, nikoli však renální clearance. Opatrnost je nutná při poruše ledvin nebo srdce.",
      "effect_type": "antagonism",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "ACE inhibitory nebo antagonisté receptorů pro angiotensin II",
      "effect": "U některých pacientů se sníženou funkcí ledvin, například při dehydrataci nebo ve vyšším věku, může kombinace s Aulinem zhoršit funkci ledvin, někdy až způsobit akutní selhání ledvin. Lékař může zejména u starších pacientů sledovat funkci ledvin a dbát na dostatečnou hydrataci.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Léky metabolizované CYP2C9",
      "effect": "Nimesulid inhibuje CYP2C9, takže při současném podávání se mohou zvýšit plazmatické koncentrace léků metabolizovaných tímto enzymem.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Inhibitory syntézy prostaglandinů",
      "effect": "Při užívání nimesulidu méně než 24 hodin před methotrexátem nebo po něm se mohou zvýšit jeho sérové hladiny a toxicita. Inhibitory syntézy prostaglandinů, jako nimesulid, mohou také zvýšit nefrotoxicitu cyklosporinu.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {

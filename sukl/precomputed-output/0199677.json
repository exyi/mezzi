    {
      "class_id": "atc:C01B",
      "drug_class": "Antiarytmika třídy I",
      "effect": "Bisoprolol může zesílit účinek na dobu AV převodu a negativní inotropní účinek antiarytmik třídy I, například disopyramidu, chinidinu, lidokainu, fenytoinu, flekainidu nebo propafenonu. Kombinace se obecně nedoporučuje; pacient se má před souběžným užíváním poradit s lékařem.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:C08D",
      "drug_class": "Blokátory kalciových kanálů typu verapamilu nebo diltiazemu",
      "effect": "Bisoprolol může spolu s verapamilem, a v menší míře diltiazemem, nepříznivě ovlivnit srdeční stah a AV převod. Intravenózní verapamil při léčbě beta-blokátorem může způsobit těžkou hypotenzi a AV blok. Kombinace se obecně nedoporučuje; pacient se má poradit s lékařem.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:C02",
      "drug_class": "Centrálně působící antihypertenziva",
      "effect": "Kombinace bisoprololu s klonidinem, methyldopou, moxonidinem nebo rilmenidinem může zhoršit srdeční selhání snížením tepové frekvence a srdečního výdeje a rozšířením cév. Náhlé vysazení těchto léků, zvláště před ukončením léčby beta-blokátorem, může zvýšit riziko prudkého zvýšení krevního tlaku. Kombinace se obecně nedoporučuje; tyto léky nevysazujte bez předchozí porady s lékařem.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:C08CA",
      "drug_class": "Blokátory kalciových kanálů dihydropyridinového typu",
      "effect": "Souběžné užívání s bisoprololem může zvýšit riziko nízkého krevního tlaku; u pacientů se srdečním selháním nelze vyloučit další zhoršení funkce srdečních komor. Lékař může provádět častější kontroly. Příklady jsou nifedipin, felodipin a amlodipin.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },

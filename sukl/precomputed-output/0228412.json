      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Léky snižující hladinu vápníku v krvi",
      "effect": "Současné užívání s cinakalcetem může zvýšit riziko nízké hladiny vápníku v krvi. Hladinu vápníku je třeba pečlivě sledovat; etelkalcetid se s cinakalcetem nesmí podávat.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Silné inhibitory CYP3A4",
      "effect": "Mohou zvýšit hladinu cinakalcetu; ketokonazol ji při podání 200 mg dvakrát denně zvýšil přibližně dvojnásobně. Při zahájení nebo ukončení léčby může být nutná úprava dávky cinakalcetu. Mezi příklady patří ketokonazol, itrakonazol, telithromycin, vorikonazol a ritonavir.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Induktory CYP3A4",
      "effect": "Při zahájení nebo ukončení léčby může být nutná úprava dávky cinakalcetu. Příkladem je rifampicin.",
      "effect_type": null,
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Silné inhibitory CYP1A2",
      "effect": "Působení silných inhibitorů CYP1A2 na hladinu cinakalcetu nebylo studováno. Při zahájení nebo ukončení souběžné léčby může být nutná úprava dávky cinakalcetu. Příklady jsou fluvoxamin a ciprofloxacin.",
      "effect_type": null,
      "side_effects": []
    },
    {
      "class_id": null,
      "drug": "kouření",
      "effect": "Kouření zvyšuje clearance cinakalcetu; u kuřáků byla o 36–38 % vyšší než u nekuřáků. Při zahájení nebo ukončení kouření se mohou změnit hladiny cinakalcetu a může být nutná úprava jeho dávky.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:cyp2d6_inhibitor",
      "drug_class": "Léky s úzkým terapeutickým rozmezím, které se individuálně upravují a metabolizují hlavně přes CYP2D6",
      "effect": "Cinakalcet silně inhibuje CYP2D6 a může zvýšit hladiny těchto léků. Lékař může upravit jejich dávku. Příklady jsou flekainid, propafenon, metoprolol, desipramin, nortriptylin a klomipramin.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug": "desipramin",
      "effect": "Cinakalcet 90 mg jednou denně zvýšil expozici desipraminu 50 mg až 3,6krát u pacientů, kteří jej rychle metabolizují přes CYP2D6.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug": "dextromethorfan",
      "effect": "Opakované dávky cinakalcetu 50 mg zvýšily expozici dextromethorfanu 30 mg 11krát u pacientů, kteří jej rychle metabolizují přes CYP2D6.",
      "effect_type": "increased_exposure",
      "side_effects": []
    }

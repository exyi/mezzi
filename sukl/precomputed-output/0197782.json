  "combinations": [
    {
      "drug_class": "Léky s anticholinergními vlastnostmi",
      "effect": "Současné užívání může zesílit léčebný účinek i nežádoucí účinky. Mezi ukončením přípravku Urizia a zahájením jiné anticholinergní léčby je nutná přestávka přibližně jeden týden.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "drug_class": "Agonisté cholinergních receptorů (cholinergika)",
      "effect": "Současné podávání může snížit léčebný účinek solifenacinu, a tím i přípravku Urizia.",
      "effect_type": "antagonism",
      "side_effects": []
    },
    {
      "drug_class": "Léky stimulující motilitu trávicího traktu (např. metoklopramid, cisaprid)",
      "effect": "Přípravek Urizia může snižovat účinek těchto léků, které stimulují pohyb trávicího ústrojí.",
      "effect_type": "antagonism",
      "side_effects": []
    },
    {
      "drug_class": "Jiní antagonisté α1-adrenoreceptorů (jiné alfablokátory)",
      "effect": "Současné podávání může snižovat krevní tlak; může proto dojít k nežádoucímu poklesu krevního tlaku.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "drug_class": "Silné inhibitory CYP3A4 (např. ketokonazol, ritonavir, nelfinavir, itrakonazol)",
      "effect": "Mohou zvýšit expozici solifenacinu i tamsulosinu; ketokonazol zvýšil expozici solifenacinu až 2,8násobně a tamsulosinu 2,8násobně. Přípravek Urizia se při současném užívání těchto inhibitorů používá s opatrností a maximální denní dávka je jedna tableta. U pacientů, kteří jsou současně pomalými metabolizátory CYP2D6 nebo užívají silný inhibitor CYP2D6, se přípravek Urizia s inhibitorem CYP3A4 nesmí podávat. U pacientů s těžkou poruchou funkce ledvin nebo se středně těžkým poškozením jater je současné podávání se silným inhibitorem CYP3A4 kontraindikováno.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "drug_class": "Středně silné inhibitory CYP3A4 (např. verapamil)",
      "effect": "Mohou zvýšit expozici tamsulosinu i solifenacinu; při verapamilu se Cmax a AUC tamsulosinu zvýšily přibližně 2,2násobně a u solifenacinu přibližně 1,6násobně. Přípravek Urizia se má v této kombinaci užívat s opatrností a maximální denní dávka je jedna tableta.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "drug": "Cimetidin",
      "effect": "Cimetidin jako slabý inhibitor CYP3A4 zvýšil AUC tamsulosinu 1,44násobně, zatímco Cmax se významně nezměnila. Přípravek Urizia lze se slabými inhibitory CYP3A4 užívat.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "drug_class": "Inhibitory CYP2D6 (např. paroxetin)",
      "effect": "Paroxetin v dávce 20 mg denně zvýšil Cmax tamsulosinu 1,3násobně a AUC 1,6násobně. Přípravek Urizia lze s inhibitory CYP2D6 užívat; při současném užívání silného inhibitoru CYP2D6 a inhibitoru CYP3A4 se však přípravek Urizia nesmí podávat.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "drug_class": "Induktory CYP3A4 (např. rifampicin)",
      "effect": "Interakce nebyly studovány, ale protože se obě léčivé látky metabolizují prostřednictvím CYP3A4, induktory CYP3A4 mohou snížit plazmatické koncentrace solifenacinu a tamsulosinu.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {

  "combinations": [
    {
      "class_id": null,
      "drug_class": "Inhibitory monoaminooxidázy (MAO)",
      "effect": "Transtec se nesmí používat současně s inhibitory MAO ani během 14 dnů po jejich užívání. V SPC se uvádí, že život ohrožující interakce s pethidinem byly pozorovány a obdobné interakce s Transtec nelze vyloučit.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "group:cns_depressant",
      "drug_class": "Léky tlumící centrální nervový systém nebo dýchání, včetně opioidů, anestetik, léků na spaní, sedativ, antidepresiv, neuroleptik, gabapentinu a pregabalinu",
      "effect": "Současné užívání s Transtec může zesílit útlum centrálního nervového systému, ospalost a útlum dýchání. Se sedativy, jako jsou benzodiazepiny nebo podobné látky, se zvyšuje riziko sedace, útlumu dýchání, kómatu a úmrtí; současné podání je určeno jen tehdy, když není jiná léčba. Lékař má omezit dávku a dobu společného užívání a pacienta pečlivě sledovat. Totéž riziko útlumu platí pro alkohol.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:serotonergic",
      "drug_class": "Serotonergní léčivé látky, například SSRI, SNRI a tricyklická antidepresiva",
      "effect": "Současné užívání s Transtec může vyvolat serotoninový syndrom. Při klinicky odůvodněné kombinaci se doporučuje pečlivé sledování, zejména při zahájení léčby a zvýšení dávky; při podezření lékař zváží snížení dávky nebo přerušení léčby.",
      "effect_type": "increased_toxicity",
      "side_effects": [
        {
          "ctcae": "Serotonin syndrome",
          "frequency": null,
          "label": "Serotoninový syndrom při současném užívání se serotonergními léky; mohou se objevit mimovolní rytmické stahy svalů, neklid s potřebou pohybu, halucinace, bezvědomí, nadměrné pocení, třes, zvýšené reflexy, zvýšené napětí svalů nebo teplota nad 38 °C.",
          "action": "contact_doctor",
          "action_condition": {
            "patient_guide": "Pokud se objeví uvedené příznaky, například mimovolní rytmické stahy svalů, neklid s potřebou pohybu, halucinace, bezvědomí, nadměrné pocení, třes, zvýšené reflexy, zvýšené napětí svalů nebo teplota nad 38 °C.",
            "min_severity": 2
          }
        }
      ]
    },
    {
      "class_id": "group:cyp3a4_inhibitor",

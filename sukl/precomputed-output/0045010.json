  "side_effects": [
    {
      "ctcae": "Anaphylaxis",
      "frequency": "not_known",
      "label": "Alergická reakce: náhlé sípání, potíže s dýcháním, otok očních víček, obličeje nebo rtů, případně vyrážka či svědění po těle.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Pokud se objeví náhlé sípání, potíže s dýcháním, otok očních víček, obličeje nebo rtů, případně vyrážka či svědění po těle.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Cardiac disorders - Other, specify",
      "frequency": "not_known",
      "label": "Rychlý nebo nepravidelný srdeční tep; může jít o srdeční arytmii nebo torsade de pointes.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Pokud máte rychlý nebo nepravidelný srdeční tep.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Hepatic failure",
      "frequency": "not_known",
      "label": "Selhání jater nebo jaterní nekróza; možné příznaky jsou tmavá moč, ztráta chuti k jídlu nebo zežloutnutí kůže či očního bělma.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Pokud máte tmavou moč, ztrácíte chuť k jídlu nebo vám žloutne kůže či oční bělmo.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Colitis",
      "frequency": "not_known",
      "label": "Závažný průjem s křečemi v břiše, krvavou stolicí a/nebo horečkou může znamenat kolitidu spojenou s antibiotiky. Neužívejte léky proti průjmu, které zpomalují pohyb střev.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Pokud máte závažný průjem s křečemi v břiše, krvavou stolicí a/nebo horečkou.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Stevens-Johnson syndrome",
      "frequency": "not_known",
      "label": "Stevensův-Johnsonův syndrom: terčovité nebo kruhové zarudlé skvrny, často s puchýřem uprostřed, olupování kůže nebo vředy v ústech, krku, nose, na genitáliích či očích; může jim předcházet horečka a příznaky podobné chřipce.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Pokud se objeví terčovité či kruhové skvrny, puchýře, olupování kůže nebo vředy v ústech, krku, nose, na genitáliích či očích, případně jim předchází horečka a příznaky podobné chřipce.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Toxic epidermal necrolysis",
      "frequency": "not_known",
      "label": "Toxická epidermální nekrolýza: terčovité nebo kruhové zarudlé skvrny, často s puchýřem uprostřed, olupování kůže nebo vředy v ústech, krku, nose, na genitáliích či očích; může jim předcházet horečka a příznaky podobné chřipce.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Pokud se objeví terčovité či kruhové skvrny, puchýře, olupování kůže nebo vředy v ústech, krku, na genitáliích či očích, případně jim předchází horečka a příznaky podobné chřipce.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Rash maculo-papular",
      "frequency": "rare",
      "label": "DRESS syndrom: rozsáhlá vyrážka, vysoká tělesná teplota a zvětšené lymfatické uzliny; může postihnout až 1 osobu z 1 000.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Pokud se objeví rozsáhlá vyrážka, vysoká tělesná teplota a zvětšené lymfatické uzliny.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Pustular drug eruption",
      "frequency": "rare",
      "label": "Akutní generalizovaná exantematózní pustulóza: rozsáhlá červená šupinatá vyrážka s hrbolky pod kůží a puchýři, doprovázená horečkou; obvykle se objeví při zahájení léčby a může postihnout až 1 osobu z 1 000.",
      "action": "discontinue_treatment",
      "action_condition": {
        "patient_guide": "Pokud se objeví rozsáhlá červená šupinatá vyrážka s hrbolky pod kůží a puchýři a horečkou.",
        "min_severity": null
      }
    },
    {
      "ctcae": "Diarrhea",
      "frequency": "very_common",
      "label": "Průjem; pokud během léčby nebo po ní zesílí, je závažný, nebo přetrvává či se znovu objeví během prvního týdne po léčbě, poraďte se s lékařem. Bez předchozí porady s lékařem neužívejte léky proti průjmu.",
      "action": "contact_doctor",
      "action_condition": {
        "patient_guide": "Pokud je průjem závažný, během léčby nebo po ní, nebo pokračuje či se znovu objeví během prvního týdne po léčbě.",
        "min_severity": null
      }
    },

    {
      "class_id": "atc:A10",
      "drug_class": "Antidiabetika",
      "effect": "Byly ojediněle hlášeny hypoglykemické nebo hyperglykemické účinky, kvůli nimž bylo třeba změnit dávkování antidiabetik. Při současné léčbě se doporučuje sledovat hladinu glukózy.",
      "effect_type": "changed_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:1962",
      "drug": "Methotrexát",
      "effect": "Diklofenak může zpomalit vylučování methotrexátu ledvinami a zvýšit jeho hladinu a toxicitu. Opatrnost je zvlášť důležitá, pokud je diklofenak podán méně než 24 hodin před léčbou methotrexátem nebo po ní.",
      "effect_type": "increased_toxicity",

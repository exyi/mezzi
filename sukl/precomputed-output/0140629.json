  "side_effects": [
    {
      "ctcae": "Headache",
      "frequency": "very_common",
      "label": "Bolest hlavy; u pacientů po jednotlivé intravenózní dávce až 38,5 mg byl hlášen jen mírný průběh.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Constipation",
      "frequency": "very_common",
      "label": "Zácpa; může být přechodná. Lékař bude kontrolovat váš zdravotní stav.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Insomnia",
      "frequency": "common",
      "label": "Nespavost.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Alanine aminotransferase increased",
      "frequency": "common",
      "label": "Zvýšené hladiny jaterních transamináz, prokazatelné v krevních testech; u pacientů dostávajících srovnávací léčbu se vyskytovaly s podobnou frekvencí.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Diarrhea",
      "frequency": "common",
      "label": "Průjem.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Hypersensitivity",
      "frequency": "uncommon",
      "label": "Reakce přecitlivělosti, například anafylaxe nebo kopřivka.",
      "action": "emergency",
      "action_condition": {
        "patient_guide": "Otok hrdla, obličeje, rtů nebo úst, případně potíže s dýcháním či polykáním.",
        "min_severity": 1
      }
    },
    {
      "ctcae": "Extrapyramidal disorder",
      "frequency": "uncommon",
      "label": "Extrapyramidové reakce; v příbalové informaci jsou popsány jako abnormální mimovolní pohyby, například třes, svalová ztuhlost a záškuby.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Serotonin syndrome",
      "frequency": "uncommon",
      "label": "Serotoninový syndrom; může se objevit při užívání samotného granisetronu, pravděpodobnější je při kombinaci s některými dalšími léky. Může zahrnovat změny duševního stavu, autonomní nestabilitu, nervosvalové nebo zažívací příznaky.",
      "action": "emergency",
      "action_condition": {
        "patient_guide": "Průjem, nevolnost či zvracení, vysoká teplota a krevní tlak, nadměrné pocení, zrychlený tep, neklid, zmatenost, halucinace, třes, svalové záškuby či ztuhlost nebo ztráta koordinace.",
        "min_severity": 1
      }
    },
    {
      "ctcae": "Electrocardiogram QT corrected interval prolonged",
      "frequency": "uncommon",
      "label": "Prodloužení QT intervalu na EKG; byly hlášeny také jiné změny EKG.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Rash maculo-papular",
      "frequency": "uncommon",
      "label": "Kožní vyrážka; příbalová informace uvádí také alergickou kožní reakci nebo kopřivku s červenými, vystouplými a svědivými pupínky.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Urticaria",
      "frequency": "uncommon",
      "label": "Kopřivka, případně s červenými, vystouplými a svědivými pupínky.",
      "action": null,
      "action_condition": null
    }
  ],
  "combinations": [
    {
      "class_id": "group:qt_prolonging",
      "drug_class": "Léky prodlužující QT interval nebo s proarytmickým účinkem",
      "effect": "Současné užívání s granisetronem může zvýšit riziko klinicky významných změn EKG včetně prodloužení QT intervalu. U pacientů užívajících tyto léky se doporučuje sledování EKG a klinických příznaků.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:12975",
      "drug": "GRANISETRON-HYDROCHLORID",
      "effect": "Příbalová informace doporučuje poradit se s lékařem před současným užíváním jiného antagonisty receptoru 5-HT3, například dolasetronu nebo ondansetronu. SPC uvádí zkříženou senzitivitu mezi antagonisty 5-HT3; konkrétní míra rizika pro tuto kombinaci není uvedena.",
      "effect_type": null,
      "side_effects": []
    },
    {
      "class_id": "substance:12975",
      "drug": "GRANISETRON-HYDROCHLORID",
      "effect": "Při současném užívání granisetronu se serotonergními léky, včetně SSRI a SNRI, byly hlášeny případy serotoninového syndromu; SPC doporučuje opatrnost a sledování příznaků.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:12975",
      "drug": "GRANISETRON-HYDROCHLORID",
      "effect": "Současné užívání granisetronu s léčivými přípravky nebo opioidy obsahujícími buprenorfin může zvýšit riziko serotoninového syndromu, potenciálně život ohrožujícího stavu; SPC doporučuje opatrnost a sledování příznaků.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:12975",
      "drug": "GRANISETRON-HYDROCHLORID",
      "effect": "Fenobarbital může ovlivňovat způsob, jakým granisetron účinkuje; příbalová informace doporučuje tuto kombinaci oznámit lékaři nebo lékárníkovi. Směr a velikost účinku nejsou uvedeny.",
      "effect_type": null,
      "side_effects": []
    },
    {
      "class_id": "substance:12975",
      "drug": "GRANISETRON-HYDROCHLORID",
      "effect": "Ketokonazol může ovlivnit účinek granisetronu; příbalová informace doporučuje tuto kombinaci oznámit lékaři nebo lékárníkovi. In vitro inhibice metabolismu granisetronu není podle SPC považována za klinicky významnou.",
      "effect_type": null,
      "side_effects": []
    },
    {
      "class_id": "substance:12975",
      "drug": "GRANISETRON-HYDROCHLORID",
      "effect": "Erythromycin může ovlivňovat způsob, jakým granisetron účinkuje; příbalová informace doporučuje tuto kombinaci oznámit lékaři nebo lékárníkovi. Směr a velikost účinku nejsou uvedeny.",
      "effect_type": null,

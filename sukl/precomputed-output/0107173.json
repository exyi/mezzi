  "combinations": [
    {
      "class_id": "group:hyperkalemia_risk",
      "drug_class": "Léky zvyšující hladinu draslíku",
      "effect": "Losartan spolu s přípravky draslíku, náhražkami soli s draslíkem, diuretiky šetřícími draslík (např. amiloridem, triamterenem, spironolaktonem), heparinem nebo přípravky obsahujícími trimethoprim může zvýšit hladinu draslíku v krvi; tato kombinace se nedoporučuje.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Inhibitory ACE a blokátory receptorů pro angiotensin II",
      "effect": "Souběžné užívání losartanu s inhibitorem ACE se nedoporučuje, protože může zhoršit funkci ledvin a zvýšit riziko nízkého tlaku a vysoké hladiny draslíku. U pacientů s diabetickou nefropatií se inhibitory ACE a blokátory receptorů pro angiotensin II nesmějí užívat současně.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug": "Aliskiren",
      "effect": "Losartan s aliskirenem je kontraindikován u pacientů s diabetem nebo poruchou funkce ledvin (GFR pod 60 ml/min/1,73 m²). Kombinace může zvýšit riziko nízkého tlaku, vysoké hladiny draslíku a zhoršení funkce ledvin.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Jiná antihypertenziva a léky snižující krevní tlak jako nežádoucím účinkem",
      "effect": "Jiná antihypertenziva a látky, které mohou snižovat krevní tlak jako nežádoucím účinkem, mohou zesílit účinek losartanu a zvýšit riziko nízkého tlaku. Patří sem tricyklická antidepresiva, antipsychotika, baklofen a amifostin.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Nesteroidní protizánětlivé léky",
      "effect": "Nesteroidní protizánětlivé léky, včetně inhibitorů COX-2 a kyseliny acetylsalicylové v protizánětlivých dávkách, mohou oslabit účinek losartanu na krevní tlak. Společně s losartanem nebo diuretiky mohou také zvýšit riziko zhoršení funkce ledvin, včetně akutního selhání ledvin, a zvýšení draslíku v krvi, zejména při již narušené funkci ledvin a u starších pacientů. Lékař může zvážit sledování funkce ledvin; pacient má být dostatečně zavodněn.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug": "Lithium",
      "effect": "Souběžné užívání lithia a losartanu může zvýšit hladinu lithia v krvi a jeho toxicitu. Kombinace vyžaduje opatrnost a pečlivý dohled lékaře; může být vhodné sledovat hladinu lithia v krvi.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug": "Flukonazol",
      "effect": "Flukonazol jako inhibitor CYP2C9 snížil v klinickém hodnocení expozici aktivnímu metabolitu losartanu přibližně o 50 %; klinický význam tohoto účinku není znám.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug": "Rifampicin",
      "effect": "Rifampicin jako induktor metabolických enzymů vedl při souběžné léčbě s losartanem ke 40% snížení plazmatické koncentrace aktivního metabolitu; klinický význam tohoto účinku není znám.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug": "Fluvastatin",
      "effect": "Při souběžné léčbě losartanem a fluvastatinem, slabým inhibitorem CYP2C9, nebyl zjištěn rozdíl v expozici.",
      "effect_type": "changed_exposure",
      "side_effects": []

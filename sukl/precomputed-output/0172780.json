  "combinations": [
    {
      "class_id": "group:cns_depressant",
      "drug_class": "Léky tlumící centrální nervovou soustavu",
      "effect": "Mohou zesílit nežádoucí účinky oxykodonu, zejména útlum dýchání. Patří sem opioidy, gabapentinoidy, léky na úzkost, spaní a uklidnění, antipsychotika, antidepresiva a alkohol.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cns_depressant",
      "drug_class": "Sedativa, například benzodiazepiny nebo podobné léky",
      "effect": "Současné užívání s oxykodonem zvyšuje riziko ospalosti, útlumu dýchání, kómatu a úmrtí. Kombinace je určena jen tehdy, když není jiná možnost; lékař má omezit dávku a dobu užívání a pečlivě sledovat známky útlumu dýchání a sedace.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug_class": "Léky s anticholinergním účinkem",
      "effect": "Mohou zesílit některé nežádoucí účinky oxykodonu, například zácpu, sucho v ústech a poruchy močení.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inhibitor",
      "drug_class": "Inhibitory CYP3A4",
      "effect": "Mohou snížit odbourávání oxykodonu a zvýšit jeho hladinu v krvi a účinek. Jde například o makrolidová antibiotika, azolová antimykotika, inhibitory proteáz, cimetidin a grapefruitovou šťávu; lékař může upravit dávku. Ve studiích se po itrakonazolu, vorikonazolu, telithromycinu nebo grapefruitové šťávě zvýšila expozice oxykodonu v rozsahu popsaném v SPC.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:cyp3a4_inducer",
      "drug_class": "Induktory CYP3A4",
      "effect": "Mohou zvýšit odbourávání oxykodonu a snížit jeho hladinu v krvi a účinek; lékař může upravit dávku. Patří sem například rifampicin, karbamazepin, fenytoin a třezalka tečkovaná.",
      "effect_type": "decreased_exposure",
      "side_effects": []
    },
    {
      "class_id": "group:cyp2d6_inhibitor",
      "drug_class": "Inhibitory CYP2D6",
      "effect": "Mohou snížit odbourávání oxykodonu a zvýšit jeho hladinu v krvi; jde například o paroxetin a chinidin.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },

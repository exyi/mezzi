      }
    },
    {
      "ctcae": "White blood cell decreased",
      "frequency": "very_common",
      "label": "Pokles počtu bílých krvinek.",
      "action": "emergency",
      "action_condition": {
        "patient_guide": "Pokud máte horečku nebo známky infekce, například bolest v krku, bolest v ústech nebo potíže s močením.",
        "min_severity": 1
      }
    },
    {
      "ctcae": "Leukemia secondary to oncology chemotherapy",
      "frequency": "common",
      "label": "Druhotná akutní rakovina krve, zejména leukemie; riziko je hlášeno hlavně při dlouhodobé léčbě. Příbalová informace uvádí druhotnou rakovinu krve.",
      "action": null,
      "action_condition": null
    },
    {
      "ctcae": "Myelodysplastic syndrome",
      "frequency": "common",
      "label": "Druhotný myelodysplastický syndrom, zejména po dlouhodobé léčbě.",
      "action": null,
      "action_condition": null
    },
    {

    {
      "ctcae": "Seizure",
      "frequency": "common",
      "label": "Epileptické záchvaty u dětí s nefrotickým syndromem; vzácně byly hlášeny fokální nebo generalizované záchvaty u dětí i dospělých při běžných denních dávkách nebo vysokodávkových pulzních režimech. Riziko může být vyšší při záchvatovém onemocnění v minulosti.",
      "action": "emergency",
      "action_condition": {
        "patient_guide": null,
        "min_severity": 1
      }
    },
    {

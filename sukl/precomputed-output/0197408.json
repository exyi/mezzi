  "combinations": [
    {
      "class_id": "substance:16590",
      "drug": "Escitalopram-oxalát",
      "effect": "Při současném užívání s ireverzibilními neselektivními inhibitory MAO hrozí závažné nežádoucí účinky včetně serotoninového syndromu; současné užívání je kontraindikováno. Escitalopram lze zahájit nejdříve 14 dní po ukončení inhibitoru MAO a inhibitor MAO nejdříve 7 dní po ukončení escitalopramu.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "atc:N06AG",
      "drug": "Escitalopram-oxalát",
      "effect": "Současné užívání s moklobemidem (reverzibilním inhibitorem MAO-A) je kontraindikováno kvůli riziku serotoninového syndromu. Pokud je kombinace nutná, SPC uvádí zahájení nejnižší doporučenou dávkou a pečlivé sledování; PIL doporučuje užití jen pod pečlivým dohledem lékaře.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": null,
      "drug": "Escitalopram-oxalát",
      "effect": "Linezolid, reverzibilní neselektivní inhibitor MAO, se při léčbě escitalopramem nesmí podávat; hrozí serotoninový syndrom. Pokud je kombinace nezbytná, SPC uvádí minimální dávky a pečlivý klinický dohled; PIL připouští užití pouze pod pečlivým dohledem lékaře.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "group:qt_prolonging",
      "drug": "Escitalopram-oxalát",
      "effect": "Současné užívání s léčivými přípravky prodlužujícími QT interval je kontraindikováno kvůli riziku poruch srdečního rytmu. Jde například o antiarytmika tříd IA a III, některá antipsychotika, tricyklická antidepresiva, některá antimikrobiální léčiva, antimalarika a antihistaminika; SPC a PIL se mírně liší v uvedených příkladech.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "group:serotonergic",
      "drug": "Escitalopram-oxalát",
      "effect": "Současné podávání se serotonergními léčivy, například tramadolem, buprenorfinem, sumatriptanem nebo jinými triptany, může vyvolat serotoninový syndrom. Při kombinaci je třeba opatrnost; u lithium a tryptofanu byly hlášeny případy zvýšení účinku SSRI a SPC doporučuje zvýšenou opatrnost.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "group:cyp2c19_inhibitor",
      "drug": "Escitalopram-oxalát",
      "effect": "Léky, které inhibují CYP2C19, mohou zvýšit hladinu escitalopramu v krvi. SPC uvádí opatrnost při kombinaci a možnost snížení dávky escitalopramu podle nežádoucích účinků; u cimetidinu 400 mg dvakrát denně se hladina zvýšila přibližně o 70 %.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "substance:16590",
      "drug": "Escitalopram-oxalát",
      "effect": "Escitalopram může zvýšit hladinu některých léků metabolizovaných převážně CYP2D6, například flekainidu, propafenonu, metoprololu, desipraminu, klomipraminu, nortriptylinu, risperidonu, thioridazinu a haloperidolu. U desipraminu a metoprololu se jejich hladiny zvýšily dvojnásobně; může být nutná úprava dávky těchto léků.",
      "effect_type": "increased_exposure",
      "side_effects": []
    },
    {
      "class_id": "atc:M01A",
      "drug": "Escitalopram-oxalát",
      "effect": "Při současném užívání s nesteroidními protizánětlivými léky může být zvýšeno riziko krvácení. SPC doporučuje opatrnost; další vyjmenované léky ovlivňující krevní destičky jsou kyselina acetylsalicylová, tiklopidin a dipyridamol.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {

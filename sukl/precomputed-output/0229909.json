  "combinations": [
    {
      "class_id": "atc:C09XA02",
      "drug_class": "Aliskiren",
      "effect": "Současné užívání je zakázáno u pacientů s diabetem nebo poruchou funkce ledvin (GFR < 60 ml/min/1,73 m²). U ostatních pacientů se kombinace nedoporučuje; zvyšuje riziko vysoké hladiny draslíku, zhoršení funkce ledvin a kardiovaskulárních komplikací. Při nezbytné duální blokádě je nutný odborný dohled a pečlivé sledování krevního tlaku, ledvin a elektrolytů.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "atc:C09C",
      "drug_class": "Blokátory receptorů pro angiotensin II (sartany)",
      "effect": "Současné užívání se obecně nedoporučuje, protože zvyšuje riziko nízkého krevního tlaku, vysoké hladiny draslíku a zhoršení funkce ledvin včetně akutního selhání. U pacientů s diabetickou nefropatií se tato kombinace nemá používat; výjimečné použití vyžaduje odborný dohled a pečlivé sledování krevního tlaku, ledvin a draslíku.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:C09DX04",
      "drug_class": "Sakubitril/valsartan",
      "effect": "Současné užívání s perindoprilem je zakázáno kvůli zvýšenému riziku angioedému. Perindopril lze zahájit nejdříve 36 hodin po poslední dávce sakubitrilu/valsartanu; opačně lze sakubitril/valsartan zahájit nejdříve 36 hodin po poslední dávce perindoprilu.",
      "effect_type": "contraindicated",
      "side_effects": []
    },
    {
      "class_id": "atc:C03D",
      "drug_class": "Kalium šetřící diuretika",
      "effect": "Kombinace se obecně nedoporučuje, protože může významně zvýšit hladinu draslíku v krvi. Pokud je podávání vhodné, je nutná opatrnost a pravidelné sledování draslíku a funkce ledvin. U spironolaktonu nebo eplerenonu v dávce 12,5–50 mg denně společně s nízkou dávkou ACE inhibitoru je při srdečním selhání NYHA II–IV a ejekční frakci < 40 % riziko vysoké hladiny draslíku, která může být smrtelná; před zahájením a během léčby se doporučuje pečlivé sledování draslíku a kreatininu.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:A12B",
      "drug_class": "Přípravky s draslíkem a náhražky soli obsahující draslík",
      "effect": "Společné užívání s perindoprilem, zejména při poruše funkce ledvin, může významně zvýšit hladinu draslíku v krvi. Kombinace se obecně nedoporučuje; pokud je nezbytná, vyžaduje opatrnost a pravidelné kontroly draslíku a funkce ledvin.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:13049",
      "drug": "Heparin",
      "effect": "Při současném užívání s perindoprilem se může zvýšit hladina draslíku v krvi; doporučuje se její kontrola.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "substance:13049",
      "drug": "Trimethoprim",
      "effect": "Při současném užívání s perindoprilem se může zvýšit hladina draslíku v krvi. Trimethoprim působí podobně jako kalium šetřící diuretikum; kombinace se nedoporučuje, a pokud je nutná, vyžaduje opatrnost a pravidelné kontroly draslíku.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:J01EE01",
      "drug_class": "Kotrimoxazol (trimethoprim/sulfamethoxazol)",
      "effect": "Současné užívání s perindoprilem může zvýšit hladinu draslíku v krvi; kombinace se nedoporučuje a při nezbytném podávání vyžaduje opatrnost a pravidelné kontroly draslíku.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:M01A",
      "drug_class": "Nesteroidní protizánětlivé léky (NSAID), včetně kyseliny acetylsalicylové v dávce ≥ 3 g/den",
      "effect": "Při současném užívání může být oslaben účinek perindoprilu na snížení krevního tlaku a může se zvýšit riziko zhoršení funkce ledvin včetně akutního selhání a zvýšení draslíku v krvi, zejména u starších pacientů a při již snížené funkci ledvin. Doporučuje se opatrnost, dostatečný příjem tekutin a zvážení sledování funkce ledvin po zahájení kombinace a dále pravidelně.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:N05AN01",
      "drug_class": "Lithium",
      "effect": "Při současném podávání s perindoprilem byly hlášeny vratné zvýšení hladiny lithia v krvi a jeho toxicita. Kombinace se nedoporučuje; je-li nezbytná, lékař pečlivě sleduje hladinu lithia.",
      "effect_type": "increased_toxicity",
      "side_effects": []
    },
    {
      "class_id": "atc:A10",
      "drug_class": "Antidiabetika (inzulin nebo perorální antidiabetika)",
      "effect": "Perindopril může zesílit účinek na snížení hladiny cukru v krvi a zvýšit riziko hypoglykemie, zejména během prvních týdnů kombinované léčby a u pacientů s poruchou funkce ledvin. U diabetiků léčených inzulinem nebo perorálními antidiabetiky se doporučuje pečlivé sledování glykemie během prvního měsíce léčby ACE inhibitorem.",
      "effect_type": "synergy",
      "side_effects": []
    },
    {
      "class_id": "atc:M03BX01",
      "drug_class": "Baklofen",
      "effect": "Baklofen může zesílit účinek perindoprilu na snížení krevního tlaku; lékař může sledovat tlak a případně upravit dávku antihypertenziva.",
      "effect_type": "synergy",
      "side_effects": []
    },
